// Модуль объекта внешней обработки. Демонстрационная база VoltMarket.dt, версия 1.2.1.
Функция ВыполнитьАвтотесты() Экспорт
	Лог = Новый Массив;
	Лог.Добавить(СтрШаблон("ВольтМаркет %1 | %2 | %3", Метаданные.Версия, ИмяПользователя(), Формат(ТекущаяДатаСеанса(), "ДЛФ=DT")));
	Созданные = Новый Массив;
	Попытка
		Результат = ПоследнийНоутбук(Созданные);
		Лог.Добавить("ВМ-01 PASS — " + Результат);
	Исключение
		Лог.Добавить("ВМ-01 FAIL — " + ОписаниеОшибки());
	КонецПопытки;
	// Удаляем только ссылки, полученные при успешной записи этим сценарием.
	Пока Созданные.Количество() > 0 Цикл
		Индекс = Созданные.Количество() - 1;
		Созданные[Индекс].ПолучитьОбъект().Удалить();
		Созданные.Удалить(Индекс);
	КонецЦикла;
	// При автоснятии сервис обрабатывает также старые демоброни.
	// Откат возвращает все документы и регистры к состоянию перед вторым сценарием.
	НачатьТранзакцию();
	Попытка
		Результат = СнятиеПослеРучнойОтмены();
		Лог.Добавить("ВМ-02 PASS — " + Результат);
	Исключение
		Лог.Добавить("ВМ-02 FAIL — " + ОписаниеОшибки());
	КонецПопытки;
	ОтменитьТранзакцию();
	Возврат СтрСоединить(Лог, Символы.ПС);
КонецФункции

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		ВызватьИсключение Сообщение;
	КонецЕсли;
КонецПроцедуры

Функция НоваяБронь(Товар, Покупатель, Количество, ДатаДокумента)
	Док = Документы.Бронирование.СоздатьДокумент();
	Док.Заполнить(Неопределено);
	Док.Дата = ДатаДокумента;
	Док.Покупатель = Справочники.Покупатели.НайтиПоНаименованию(Покупатель, Ложь);
	Проверить(ЗначениеЗаполнено(Док.Покупатель), "В демобазе отсутствует покупатель " + Покупатель);
	Стр = Док.Товары.Добавить();
	Стр.Номенклатура = Товар;
	Стр.Количество = Количество;
	Стр.Цена = РаботаСЦенами.ЦенаДляДокумента(Товар, "Продажа");
	Возврат Док;
КонецФункции

Процедура Провести(Док, Созданные = Неопределено)
	Проверить(Док.ПроверитьЗаполнение(), "Проверка заполнения: " + Строка(Док.Метаданные().Синоним));
	Док.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	Если Созданные <> Неопределено Тогда
		Созданные.Добавить(Док.Ссылка);
	КонецЕсли;
КонецПроцедуры

Функция ОтменаНаОсновании(Бронь, ДатаДокумента)
	Отмена = Документы.ОтменаБронирования.СоздатьДокумент();
	Отмена.Дата = ДатаДокумента;
	Отмена.Заполнить(Бронь.Ссылка);
	Отмена.Причина = "Отказ покупателя";
	Возврат Отмена;
КонецФункции

Функция ПоследнийНоутбук(Созданные)
	Товар = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", "VM-NB-003");
	До = РаботаСЦенами.ОстаткиТовара(Товар);
	Проверить(До.Свободно = 1, "В начале требуется один свободный VM-NB-003");
	Момент = ТекущаяДатаСеанса() - 60;
	Первая = НоваяБронь(Товар, "Соколов", 1, Момент);
	Провести(Первая, Созданные);
	Вторая = НоваяБронь(Товар, "Кузнецова", 1, Момент + 10);
	Проверить(Первая.Покупатель <> Вторая.Покупатель, "Покупатели должны различаться");
	ПолучитьСообщенияПользователю(Истина);
	ОтказПоОстатку = Ложь;
	Попытка
		Провести(Вторая, Созданные);
	Исключение
		Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
			Если СтрНайти(Сообщение.Текст, "свободно 0 шт.") > 0 Тогда
				ОтказПоОстатку = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецПопытки;
	Проверить(ОтказПоОстатку, "Ожидался отказ в проведении из-за нулевого свободного остатка");
	ПослеОтказа = РаботаСЦенами.ОстаткиТовара(Товар);
	Проверить(ПослеОтказа.ВРезерве = До.ВРезерве + 1 И ПослеОтказа.Свободно = 0, "Отказ изменил резерв");
	Провести(ОтменаНаОсновании(Первая, Момент + 20), Созданные);
	ПослеОтмены = РаботаСЦенами.ОстаткиТовара(Товар);
	Проверить(ПослеОтмены.Свободно = 1, "Отмена должна освободить ноутбук");
	Вторая.Дата = Момент + 30;
	Провести(Вторая, Созданные);
	Итог = РаботаСЦенами.ОстаткиТовара(Товар);
	Проверить(Итог.НаСкладе = До.НаСкладе И Итог.Свободно = 0, "Итоговый остаток неверен");
	Проверить(РаботаСБронями.СостояниеБрони(Первая.Ссылка).ВРезерве = 0
		И РаботаСБронями.СостояниеБрони(Вторая.Ссылка).ВРезерве = 1, "Единица товара должна быть в резерве второго покупателя");
	Возврат СтрШаблон("VM-NB-003: свободно %1 → %2 → %3 → %4. После отказа и ручной отмены резерв перешёл второму покупателю.",
		До.Свободно, ПослеОтказа.Свободно, ПослеОтмены.Свободно, Итог.Свободно);
КонецФункции

Функция СнятиеПослеРучнойОтмены()
	Товар = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", "VM-SP-003");
	Момент = ТекущаяДатаСеанса() - 60;
	Бронь = НоваяБронь(Товар, "Соколов", 2, Момент);
	Провести(Бронь);
	Отмена = ОтменаНаОсновании(Бронь, Момент + 10);
	Отмена.Товары[0].Количество = 1;
	Провести(Отмена);
	До = РаботаСБронями.СостояниеБрони(Бронь.Ссылка);
	Проверить(До.Отменено = 1 И До.ВРезерве = 1, "После ручной отмены должна остаться одна единица");
	// Подготавливаем истёкший срок по образцу контрольного примера проекта.
	Объект = Бронь.Ссылка.ПолучитьОбъект();
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.СрокБрони = НачалоДня(ТекущаяДатаСеанса()) - 86400;
	Объект.Записать();
	Результат = РаботаСБронями.СнятьПросроченныеБрони();
	Проверить(Результат.Ошибки.Количество() = 0, СтрСоединить(Результат.Ошибки, Символы.ПС));
	Автоматических = 0;
	Для Каждого Ссылка Из Результат.Документы Цикл
		Если Ссылка.Бронирование = Бронь.Ссылка Тогда
			Автоматических = Автоматических + 1;
			Проверить(Ссылка.Автоматически И Ссылка.Товары.Итог("Количество") = 1
				И Ссылка.Причина = РаботаСБронями.ПричинаИстекСрок(), "Неверные количество, вид или причина автоматической отмены");
		КонецЕсли;
	КонецЦикла;
	После = РаботаСБронями.СостояниеБрони(Бронь.Ссылка);
	Проверить(Автоматических = 1 И После.Отменено = 2 И После.ВРезерве = 0 И После.Выкуплено = 0,
		"Ожидалась одна автоматическая отмена оставшейся единицы");
	Возврат СтрШаблон("VM-SP-003: забронировано %1, снято вручную %2, автоматически %3, осталось в резерве %4.",
		После.Забронировано, До.Отменено, После.Отменено - До.Отменено, После.ВРезерве);
КонецФункции
