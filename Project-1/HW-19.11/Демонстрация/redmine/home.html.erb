<% project = Project.visible.find_by!(identifier: 'voltmarket') %>
<% tasks = Issue.visible.where(project: project).includes(:status).order(:id) %>
<% process_url = url_for(controller: 'wiki', action: 'show', project_id: project.identifier, id: 'Процессы') %>
<% html_title 'ВольтМаркет' %>
<style>
  .vm-home {max-width: 1040px; margin: 24px auto 56px; color: #193344; font-family: "Segoe UI", Arial, sans-serif;}
  .vm-home * {box-sizing: border-box;}
  .vm-intro {padding: clamp(22px,4vw,44px); background: #123c45; color: #fff; border-radius: 12px;}
  .vm-home .vm-intro h2 {margin: 0 0 9px; padding: 0; border: 0; background: none; color: #fff; font-size: clamp(30px,5vw,46px); line-height: 1.12;}
  .vm-intro p {margin: 0; color: #deedeb; font-size: 16px; line-height: 1.55;}
  .vm-links {display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16px; margin: 18px 0 30px;}
  .vm-home a.vm-card {display: block; position: relative; padding: 21px 48px 21px 21px; border-radius: 10px; border: 1px solid #c8d8d7; color: #174f54; background: #f3f8f7; text-decoration: none;}
  .vm-card strong {display: block; font-size: 23px; margin-bottom: 5px;}
  .vm-card small {font-size: 14px; line-height: 1.4; color: #385361;}
  .vm-arrow {position: absolute; right: 20px; top: 22px; font-size: 21px;}
  .vm-home a.vm-card:hover,.vm-home a.vm-card:focus-visible {background: #e3efed; border-color: #397675;}
  .vm-home h3 {font-size: 19px; color: #193344; margin: 0 0 12px; border: 0;}
  .vm-tasks {margin: 0; padding: 0; list-style: none; border-top: 1px solid #ced9dd;}
  .vm-tasks li {display: flex; gap: 12px; align-items: baseline; padding: 14px 4px; border-bottom: 1px solid #dce4e7;}
  .vm-tasks a {font-size: 15px; font-weight: 600;}
  .vm-number {color: #576e7a; font-variant-numeric: tabular-nums;}
  .vm-status {margin-left: auto; white-space: nowrap; font-size: 13px; color: #365e55;}
  @media(max-width: 560px) {.vm-links {grid-template-columns: 1fr; gap: 9px;} .vm-home {margin: 8px auto 30px;} .vm-tasks li {gap: 7px;}}
</style>
<div class="vm-home">
  <header class="vm-intro">
    <h2>ВольтМаркет</h2>
    <p>Учёт закупок, продаж и бронирования в магазине электроники. Конфигурация 1С 1.2.1.</p>
  </header>
  <nav class="vm-links" aria-label="Разделы проекта">
    <a class="vm-card" href="<%= project_issues_path(project, set_filter: 1, status_id: '*') %>">
      <strong>Задачи</strong><small>Работы команды, статусы и вложенные файлы</small><span class="vm-arrow" aria-hidden="true">→</span>
    </a>
    <a class="vm-card" href="<%= process_url %>">
      <strong>Процессы</strong><small>Бронирование и автоснятие в BPMN 2.0</small><span class="vm-arrow" aria-hidden="true">→</span>
    </a>
  </nav>
  <h3>Работы к 19 ноября</h3>
  <ul class="vm-tasks">
    <% tasks.each do |task| %>
      <li><span class="vm-number">#<%= task.id %></span><%= link_to task.subject, issue_path(task) %><span class="vm-status"><%= task.status.name %></span></li>
    <% end %>
  </ul>
</div>
