
#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	// Наименование обязательно для элементов (у групп товаров проверяется тоже)
	ПроверяемыеРеквизиты.Добавить("Наименование");

	// Артикул уникален: по нему товар находится при быстром вводе в документах
	Если ЭтоГруппа Или ПустаяСтрока(Артикул) Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Н.Ссылка КАК Ссылка ИЗ Справочник.Номенклатура КАК Н ГДЕ Н.Артикул = &Артикул И Н.Ссылка <> &Ссылка И НЕ Н.ЭтоГруппа");
	Запрос.УстановитьПараметр("Артикул", СокрЛП(Артикул));
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон(НСтр("ru = 'Артикул %1 уже указан у товара «%2»'; zh = '货号 %1 已用于商品「%2」'"), СокрЛП(Артикул), Выборка.Ссылка);
		Сообщение.Поле = "Артикул";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
