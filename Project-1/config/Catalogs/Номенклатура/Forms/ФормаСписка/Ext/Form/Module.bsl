
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Группы товаров - жирным фирменным цветом
	Элемент = Список.УсловноеОформление.Элементы.Добавить();
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЭтоГруппа");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Истина;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветОсновной);
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтыСтиля.ШрифтЖирный);
	Элемент.Представление = НСтр("ru = 'Группы товаров'; zh = '商品分组'");

	ОбновитьКарточкуНаСервере(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ОбновитьКарточку", 0.2, Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьКарточку()

	ОбновитьКарточкуНаСервере(Элементы.Список.ТекущаяСтрока);

КонецПроцедуры

&НаСервере
Процедура ОбновитьКарточкуНаСервере(Ссылка)

	ДвоичныеДанные = Неопределено;

	Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.Номенклатура") И ЗначениеЗаполнено(Ссылка) Тогда

		Если Ссылка.ЭтоГруппа Тогда
			Элементы.ДекорацияНаименование.Заголовок = НСтр("ru = 'Группа: '; zh = '分组：'") + Ссылка.Наименование;
			Элементы.ДекорацияЦена.Заголовок = "";
			Элементы.ДекорацияОстаток.Заголовок = "";
		Иначе
			ДвоичныеДанные = Ссылка.Фото.Получить();
			Элементы.ДекорацияНаименование.Заголовок = Ссылка.Наименование;
			Цена = РаботаСЦенами.ЦенаНоменклатуры(Ссылка);
			Элементы.ДекорацияЦена.Заголовок = СтрШаблон(НСтр("ru = 'Цена: %1 руб.'; zh = '价格：%1 卢布'"), Формат(Цена, "ЧДЦ=2; ЧН=" + НСтр("ru = 'не установлена'; zh = '未设置'")));
			Элементы.ДекорацияОстаток.Заголовок = СтрШаблон(НСтр("ru = 'На складе: %1 шт.'; zh = '库存：%1 件'"), Формат(РаботаСЦенами.ОстатокНоменклатуры(Ссылка), "ЧН=0"));
		КонецЕсли;

	Иначе
		Элементы.ДекорацияНаименование.Заголовок = НСтр("ru = 'Выберите товар в списке'; zh = '请在列表中选择商品'");
		Элементы.ДекорацияЦена.Заголовок = "";
		Элементы.ДекорацияОстаток.Заголовок = "";
	КонецЕсли;

	Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
		ДвоичныеДанные = БиблиотекаКартинок.НетФото.ПолучитьДвоичныеДанные();
	КонецЕсли;

	Если ЭтоАдресВременногоХранилища(АдресФото) Тогда
		УдалитьИзВременногоХранилища(АдресФото);
	КонецЕсли;
	АдресФото = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);

КонецПроцедуры

#КонецОбласти
