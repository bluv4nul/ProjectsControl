
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьФото(Неопределено);
	КонецЕсли;
	ОбновитьШапку();

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	ПоказатьФото(ТекущийОбъект.Фото.Получить());

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если ФотоИзменено Тогда
		Если ЕстьФото Тогда
			ТекущийОбъект.Фото = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресКартинки), Новый СжатиеДанных(9));
		Иначе
			ТекущийОбъект.Фото = Новый ХранилищеЗначения(Неопределено);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	ФотоИзменено = Ложь;
	ОбновитьШапку();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура ЗагрузитьФото(Команда)

	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Заголовок = НСтр("ru = 'Выберите фотографию товара'; zh = '选择商品照片'");
	ПараметрыДиалога.Фильтр = НСтр("ru = 'Изображения'; zh = '图片'") + " (*.png;*.jpg;*.jpeg;*.bmp;*.gif)|*.png;*.jpg;*.jpeg;*.bmp;*.gif";

	ОписаниеФайла = Ждать ПоместитьФайлНаСерверАсинх(, , , ПараметрыДиалога, УникальныйИдентификатор);
	Если ОписаниеФайла = Неопределено Или ПустаяСтрока(ОписаниеФайла.Адрес) Тогда
		Возврат;
	КонецЕсли;

	УстановитьФото(ОписаниеФайла.Адрес);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьФото(Команда)

	УдалитьФотоНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПоказатьФото(ДвоичныеДанные)

	ЕстьФото = ТипЗнч(ДвоичныеДанные) = Тип("ДвоичныеДанные");
	Если Не ЕстьФото Тогда
		ДвоичныеДанные = БиблиотекаКартинок.НетФото.ПолучитьДвоичныеДанные();
	КонецЕсли;
	АдресКартинки = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);
	Элементы.КнопкаУдалитьФото.Доступность = ЕстьФото;

КонецПроцедуры

&НаСервере
Процедура УстановитьФото(АдресФайла)

	ПоказатьФото(ПолучитьИзВременногоХранилища(АдресФайла));
	ФотоИзменено = Истина;
	Модифицированность = Истина;

КонецПроцедуры

&НаСервере
Процедура УдалитьФотоНаСервере()

	ПоказатьФото(Неопределено);
	ФотоИзменено = Истина;
	Модифицированность = Истина;

КонецПроцедуры

&НаСервере
Процедура ОбновитьШапку()

	Если Объект.Ссылка.Пустая() Тогда
		Элементы.ДекорацияЗаголовок.Заголовок = НСтр("ru = 'Новый товар'; zh = '新商品'");
		Элементы.ДекорацияЦена.Заголовок = НСтр("ru = 'Цена продажи будет доступна после установки цены'; zh = '设置价格后将显示售价'");
		Возврат;
	КонецЕсли;

	Элементы.ДекорацияЗаголовок.Заголовок = Объект.Наименование;

	Цена = РаботаСЦенами.ЦенаНоменклатуры(Объект.Ссылка);
	Остаток = РаботаСЦенами.ОстатокНоменклатуры(Объект.Ссылка);
	Элементы.ДекорацияЦена.Заголовок = СтрШаблон(НСтр("ru = 'Цена: %1 руб.   •   На складе: %2 шт.'; zh = '价格：%1 卢布   •   库存：%2 件'"),
		Формат(Цена, "ЧДЦ=2; ЧН=" + НСтр("ru = 'не установлена'; zh = '未设置'")), Формат(Остаток, "ЧН=0"));

КонецПроцедуры

#КонецОбласти
