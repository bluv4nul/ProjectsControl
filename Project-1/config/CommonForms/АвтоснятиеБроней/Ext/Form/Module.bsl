
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Расписание и включение задания меняет только администратор, снять брони вручную может и продавец
	ЕстьПравоНастройки = ПравоДоступа("Администрирование", Метаданные);
	Элементы.Использование.ТолькоПросмотр = Не ЕстьПравоНастройки;
	Элементы.КнопкаИзменитьРасписание.Видимость = ЕстьПравоНастройки;
	Элементы.КнопкаВыполнитьСейчас.Доступность = ПравоДоступа("Проведение", Метаданные.Документы.ОтменаБронирования);

	ОбновитьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИспользованиеПриИзменении(Элемент)

	УстановитьИспользование(Использование);
	ОбновитьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицФормы

&НаКлиенте
Процедура ПросроченныеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Строка = Просроченные.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Строка <> Неопределено Тогда
		ПоказатьЗначение(, Строка.Бронирование);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СнятыеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Строка = Снятые.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Строка <> Неопределено Тогда
		ПоказатьЗначение(, Строка.Отмена);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьСейчас(Команда)

	Элементы.ДекорацияРезультат.Заголовок = ВыполнитьСейчасНаСервере();
	Оповестить("ВольтМаркет_ИзмененыОстатки");

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРасписание(Команда)

	Диалог = Новый ДиалогРасписанияРегламентногоЗадания(ТекущееРасписание());
	Диалог.Показать(Новый ОписаниеОповещения("ИзменитьРасписаниеЗавершение", ЭтотОбъект));

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРасписаниеЗавершение(Расписание, ДополнительныеПараметры) Экспорт

	Если Расписание <> Неопределено Тогда
		УстановитьРасписание(Расписание);
		ОбновитьНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)

	ОбновитьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ВыполнитьСейчасНаСервере()

	Результат = РаботаСБронями.СнятьПросроченныеБрони();
	ОбновитьНаСервере();
	Если Результат.Ошибки.Количество() > 0 Тогда
		Для Каждого Текст Из Результат.Ошибки Цикл
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = Текст;
			Сообщение.Сообщить();
		КонецЦикла;
	КонецЕсли;
	Если Результат.Снято = 0 И Результат.Ошибки.Количество() = 0 Тогда
		Возврат НСтр("ru = 'Просроченных броней нет — снимать нечего'; zh = '没有过期预订，无需取消'");
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = 'Снято броней: %1'; zh = '已取消预订：%1'"), Результат.Снято);

КонецФункции

&НаСервереБезКонтекста
Функция Задание()

	Возврат РегламентныеЗадания.НайтиПредопределенное(Метаданные.РегламентныеЗадания.СнятиеПросроченныхБроней);

КонецФункции

&НаСервереБезКонтекста
Функция ТекущееРасписание()

	УстановитьПривилегированныйРежим(Истина);
	Возврат Задание().Расписание;

КонецФункции

&НаСервереБезКонтекста
Процедура УстановитьРасписание(Расписание)

	ПроверитьПравоНастройки();
	УстановитьПривилегированныйРежим(Истина);
	Задание = Задание();
	Задание.Расписание = Расписание;
	Задание.Записать();

КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьИспользование(Значение)

	ПроверитьПравоНастройки();
	УстановитьПривилегированныйРежим(Истина);
	Задание = Задание();
	Задание.Использование = Значение;
	Задание.Записать();

КонецПроцедуры

// Запрет держится на сервере, а не только на скрытой кнопке
&НаСервереБезКонтекста
Процедура ПроверитьПравоНастройки()

	Если Не ПравоДоступа("Администрирование", Метаданные) Тогда
		ВызватьИсключение НСтр("ru = 'Менять расписание и включать задание может только администратор'; zh = '只有管理员可以修改计划和启用任务'");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервере()

	УстановитьПривилегированныйРежим(Истина);
	Задание = Задание();
	Использование = Задание.Использование;
	Расписание = Задание.Расписание;
	Если Расписание.ПериодПовтораДней = 1 И Расписание.ПериодПовтораВТечениеДня = 3600 Тогда
		ТекстРасписания = НСтр("ru = 'каждый день, раз в час'; zh = '每天，每小时一次'");
	Иначе
		ТекстРасписания = Строка(Расписание);
	КонецЕсли;
	Элементы.ДекорацияРасписание.Заголовок = СтрШаблон(НСтр("ru = 'Расписание: %1'; zh = '计划：%1'"), ТекстРасписания);

	ПоследнееЗадание = Задание.ПоследнееЗадание;
	Если ПоследнееЗадание = Неопределено Тогда
		Элементы.ДекорацияПоследнийЗапуск.Заголовок = НСтр("ru = 'Последний запуск по расписанию: ещё не выполнялось'; zh = '上次按计划运行：尚未运行'");
	Иначе
		Элементы.ДекорацияПоследнийЗапуск.Заголовок = СтрШаблон(НСтр("ru = 'Последний запуск по расписанию: %1 (%2)'; zh = '上次按计划运行：%1（%2）'"),
			Формат(ПоследнееЗадание.Начало, "ДЛФ=DT"), ПоследнееЗадание.Состояние);
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);

	Брони = РаботаСБронями.АктивныеБрони();
	Просроченные.Загрузить(Брони.Скопировать(Новый Структура("Просрочена", Истина)));

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Отмена.Ссылка КАК Отмена,
	|	Отмена.Дата КАК Дата,
	|	Отмена.Бронирование.Номер КАК Номер,
	|	Отмена.Бронирование.Покупатель КАК Покупатель,
	|	ЕСТЬNULL(СУММА(Строки.Количество), 0) КАК Количество
	|ИЗ
	|	Документ.ОтменаБронирования КАК Отмена
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтменаБронирования.Товары КАК Строки
	|		ПО Отмена.Ссылка = Строки.Ссылка
	|ГДЕ
	|	Отмена.Автоматически
	|	И Отмена.Проведен
	|
	|СГРУППИРОВАТЬ ПО
	|	Отмена.Ссылка,
	|	Отмена.Дата,
	|	Отмена.Бронирование.Номер,
	|	Отмена.Бронирование.Покупатель
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	Снятые.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры

#КонецОбласти
