
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Режим = ?(ПустаяСтрока(Параметры.Режим), "Продажа", Параметры.Режим);
	Если Режим = "Закупка" Тогда
		Элементы.ДекорацияЗаголовок.Заголовок = НСтр("ru = 'Подбор товаров в поступление'; zh = '为入库选择商品'");
		Элементы.ТоварыЦена.Заголовок = НСтр("ru = 'Цена закупки'; zh = '进价'");
		ТолькоВНаличии = Ложь;
		Элементы.ТолькоВНаличии.Видимость = Ложь;
	Иначе
		Элементы.ДекорацияЗаголовок.Заголовок = ?(Режим = "Бронь",
			НСтр("ru = 'Подбор товаров в бронь'; zh = '为预订选择商品'"), НСтр("ru = 'Подбор товаров в продажу'; zh = '为销售选择商品'"));
		Элементы.ТоварыЦена.Заголовок = НСтр("ru = 'Цена продажи'; zh = '售价'");
		ТолькоВНаличии = Истина;
	КонецЕсли;

	Элементы.Товары.ОтборСтрок = Новый ФиксированнаяСтруктура("Видимость", Истина);
	ЗаполнитьТовары();
	НастроитьОформление();
	ПрименитьОтборНаСервере();
	ОбновитьКарточку(?(Товары.Количество() > 0, Товары[0].Номенклатура, Неопределено));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПоискИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)

	Поиск = Текст;
	ПрименитьОтбор();

КонецПроцедуры

&НаКлиенте
Процедура ПоискПриИзменении(Элемент)

	ПрименитьОтбор();

КонецПроцедуры

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)

	ПрименитьОтбор();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	// Двойной щелчок по товару добавляет 1 шт.
	Если Поле = Элементы.ТоварыКоличество Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	Строка = Товары.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Строка <> Неопределено Тогда
		Строка.Количество = Строка.Количество + 1;
		ОбновитьИтог();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)

	ОбновитьИтог();

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ОбновитьКарточкуТекущейСтроки", 0.2, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Перенести(Команда) Экспорт

	Результат = Новый Массив;
	Для Каждого Строка Из Товары Цикл
		Если Строка.Количество > 0 Тогда
			Результат.Добавить(Новый Структура("Номенклатура, Количество, Цена", Строка.Номенклатура, Строка.Количество, Строка.Цена));
		КонецЕсли;
	КонецЦикла;
	Закрыть(Результат);

КонецПроцедуры

&НаКлиенте
Процедура Очистить(Команда)

	Для Каждого Строка Из Товары Цикл
		Строка.Количество = 0;
	КонецЦикла;
	ОбновитьИтог();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьТовары()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Н.Ссылка КАК Номенклатура,
	|	Н.Наименование КАК Наименование,
	|	Н.Артикул КАК Артикул,
	|	Н.Родитель КАК Группа,
	|	ЕСТЬNULL(Цены.Цена, 0) КАК Цена,
	|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК НаСкладе,
	|	ЕСТЬNULL(Резерв.Всего, 0) - ЕСТЬNULL(Резерв.ПоБрони, 0) КАК ВРезерве,
	|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) - ЕСТЬNULL(Резерв.Всего, 0) + ЕСТЬNULL(Резерв.ПоБрони, 0) КАК Свободно,
	|	0 КАК Количество,
	|	ИСТИНА КАК Видимость
	|ИЗ
	|	Справочник.Номенклатура КАК Н
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Цены.СрезПоследних(&Дата, ) КАК Цены
	|		ПО Н.Ссылка = Цены.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки КАК Остатки
	|		ПО Н.Ссылка = Остатки.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Р.Номенклатура КАК Номенклатура,
	|			СУММА(Р.КоличествоОстаток) КАК Всего,
	|			СУММА(ВЫБОР
	|					КОГДА Р.Бронирование = &Бронирование
	|						ТОГДА Р.КоличествоОстаток
	|					ИНАЧЕ 0
	|				КОНЕЦ) КАК ПоБрони
	|		ИЗ
	|			РегистрНакопления.ТоварыВРезерве.Остатки КАК Р
	|		СГРУППИРОВАТЬ ПО
	|			Р.Номенклатура) КАК Резерв
	|		ПО Н.Ссылка = Резерв.Номенклатура
	|ГДЕ
	|	НЕ Н.ЭтоГруппа
	|	И НЕ Н.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Н.Родитель.Наименование,
	|	Н.Наименование";
	Запрос.УстановитьПараметр("Дата", ?(ЗначениеЗаполнено(Параметры.Дата), Параметры.Дата, ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("Бронирование", ?(ЗначениеЗаполнено(Параметры.Бронирование), Параметры.Бронирование,
		Документы.Бронирование.ПустаяСсылка()));
	Товары.Загрузить(Запрос.Выполнить().Выгрузить());

	// В поступлении предлагаем цену последней закупки
	Если Режим = "Закупка" Тогда
		ЦеныЗакупки = РаботаСЦенами.ЦеныЗакупки();
		Для Каждого Строка Из Товары Цикл
			Цена = ЦеныЗакупки.Получить(Строка.Номенклатура);
			Строка.Цена = ?(Цена = Неопределено, 0, Цена);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура НастроитьОформление()

	// Количество к добавлению - жирным синим
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыКоличество.Имя);
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Товары.Количество");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше;
	Отбор.ПравоеЗначение = 0;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветСиний);
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтыСтиля.ШрифтЖирный);

	// Пустые количества не показываем
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыКоличество.Имя);
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Товары.Количество");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = 0;
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", "");

	Если Режим = "Закупка" Тогда
		Возврат;
	КонецЕсли;

	// В продаже и брони: нет свободного остатка - строка бледная, заказано больше свободного - красным
	Элемент = УсловноеОформление.Элементы.Добавить();
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Товары.Свободно");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
	Отбор.ПравоеЗначение = 0;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНеПроведен);

	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыКоличество.Имя);
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыСвободно.Имя);
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Товары.Количество");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше;
	Отбор.ПравоеЗначение = Новый ПолеКомпоновкиДанных("Товары.Свободно");
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(198, 40, 40));
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(255, 232, 179));

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьОтбор() Экспорт

	Текст = НРег(СокрЛП(Поиск));
	Для Каждого Строка Из Товары Цикл
		Видимость = Истина;
		Если Не ПустаяСтрока(Текст) И СтрНайти(НРег(Строка.Наименование + " " + Строка.Артикул), Текст) = 0 Тогда
			Видимость = Ложь;
		КонецЕсли;
		Если ЗначениеЗаполнено(Группа) И Строка.Группа <> Группа Тогда
			Видимость = Ложь;
		КонецЕсли;
		Если ТолькоВНаличии И Строка.Свободно <= 0 И Строка.Количество = 0 Тогда
			Видимость = Ложь;
		КонецЕсли;
		Если Строка.Видимость <> Видимость Тогда
			Строка.Видимость = Видимость;
		КонецЕсли;
	КонецЦикла;
	ОбновитьИтог();

КонецПроцедуры

&НаСервере
Процедура ПрименитьОтборНаСервере()

	Для Каждого Строка Из Товары Цикл
		Строка.Видимость = Не (ТолькоВНаличии И Строка.Свободно <= 0);
	КонецЦикла;
	ОбновитьИтогНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИтог() Экспорт

	Позиций = 0;
	Штук = 0;
	Сумма = 0;
	Превышений = 0;
	Для Каждого Строка Из Товары Цикл
		Если Строка.Количество > 0 Тогда
			Позиций = Позиций + 1;
			Штук = Штук + Строка.Количество;
			Сумма = Сумма + Строка.Количество * Строка.Цена;
			Если Режим <> "Закупка" И Строка.Количество > Строка.Свободно Тогда
				Превышений = Превышений + 1;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Элементы.ДекорацияИтог.Заголовок = ТекстИтога(Позиций, Штук, Сумма, Превышений);

КонецПроцедуры

&НаСервере
Процедура ОбновитьИтогНаСервере()

	Элементы.ДекорацияИтог.Заголовок = ТекстИтога(0, 0, 0, 0);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ТекстИтога(Позиций, Штук, Сумма, Превышений)

	Если Позиций = 0 Тогда
		Возврат НСтр("ru = 'Товары не выбраны'; zh = '尚未选择商品'");
	КонецЕсли;
	Текст = СтрШаблон(НСтр("ru = 'Выбрано: %1 поз., %2 шт. на сумму %3 руб.'; zh = '已选：%1 种，%2 件，金额 %3 卢布'"),
		Позиций, Штук, Формат(Сумма, "ЧДЦ=2; ЧН=0"));
	Если Превышений > 0 Тогда
		Текст = Текст + СтрШаблон(НСтр("ru = '   ⚠ больше свободного остатка: %1 поз.'; zh = '   ⚠ 超出可售库存：%1 种'"), Превышений);
	КонецЕсли;
	Возврат Текст;

КонецФункции

&НаКлиенте
Процедура ОбновитьКарточкуТекущейСтроки()

	Строка = Элементы.Товары.ТекущиеДанные;
	Если Строка <> Неопределено Тогда
		ОбновитьКарточку(Строка.Номенклатура);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьКарточку(Номенклатура)

	ДвоичныеДанные = Неопределено;
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		Элементы.ДекорацияТовар.Заголовок = Строка(Номенклатура);
		Элементы.ДекорацияОписание.Заголовок = Номенклатура.Описание;
		ДвоичныеДанные = Номенклатура.Фото.Получить();
	Иначе
		Элементы.ДекорацияТовар.Заголовок = "";
		Элементы.ДекорацияОписание.Заголовок = "";
	КонецЕсли;
	Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
		ДвоичныеДанные = БиблиотекаКартинок.НетФото.ПолучитьДвоичныеДанные();
	КонецЕсли;
	Если ЭтоАдресВременногоХранилища(АдресФото) Тогда
		УдалитьИзВременногоХранилища(АдресФото);
	КонецЕсли;
	АдресФото = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);

КонецПроцедуры

#КонецОбласти
