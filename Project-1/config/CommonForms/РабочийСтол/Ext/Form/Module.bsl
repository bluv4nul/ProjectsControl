
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если ТекущийЯзык() = Метаданные.Языки.Китайский Тогда
		Элементы.ДекорацияБаннер.Картинка = БиблиотекаКартинок.БаннерКитайский;
	КонецЕсли;
	
	ТекущийПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	Имя = ?(ПустаяСтрока(ТекущийПользователь.ПолноеИмя), НСтр("ru = 'коллега'; zh = '同事'"), ТекущийПользователь.ПолноеИмя);
	Элементы.ДекорацияПриветствие.Заголовок = СтрШаблон(НСтр("ru = 'Здравствуйте, %1! Сегодня %2'; zh = '您好，%1！今天是 %2'"),
		Имя, Формат(ТекущаяДатаСеанса(), "ДЛФ=DD"));

	// Кнопки быстрого доступа показываем только тем, у кого есть права
	Элементы.КнопкаНовыйПриход.Видимость = ПравоДоступа("Добавление", Метаданные.Документы.Приход);
	Элементы.КнопкаНоваяПродажа.Видимость = ПравоДоступа("Добавление", Метаданные.Документы.Расход);
	Элементы.КнопкаНоваяБронь.Видимость = ПравоДоступа("Добавление", Метаданные.Документы.Бронирование);
	Элементы.КнопкаБрони.Видимость = ПравоДоступа("Просмотр", Метаданные.Документы.Бронирование);
	Элементы.КнопкаДозаказ.Видимость = Элементы.КнопкаНовыйПриход.Видимость;

	// Просроченные брони - красным
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(Элементы.АктивныеБрони.Имя);
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("АктивныеБрони.Просрочена");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Истина;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(198, 40, 40));
	Элементы.КнопкаЦены.Видимость = ПравоДоступа("Просмотр", Метаданные.РегистрыСведений.Цены);
	Элементы.КнопкаОстатки.Видимость = ПравоДоступа("Использование", Метаданные.Отчеты.ОстаткиТоваров);
	Элементы.КнопкаПродажи.Видимость = ПравоДоступа("Использование", Метаданные.Отчеты.Продажи);

	ОбновитьПоказатели();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ВольтМаркет_ИзмененыОстатки" Тогда
		ОбновитьПоказатели();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

