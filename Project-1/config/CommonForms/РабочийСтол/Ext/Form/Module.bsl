&НаКлиенте
Процедура МалоНаСкладеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Строка = МалоНаСкладе.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Строка <> Неопределено Тогда
		ПоказатьЗначение(, Строка.Номенклатура);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьПоказатели()

	НачалоМесяца = НачалоМесяца(ТекущаяДатаСеанса());

	// Товаров в каталоге
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	Справочник.Номенклатура КАК Н
	|ГДЕ
	|	НЕ Н.ЭтоГруппа
	|	И НЕ Н.ПометкаУдаления");
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Элементы.ДекорацияЗначениеТовары.Заголовок = Формат(Выборка.Количество, "ЧН=0");

	// Склад
	ЕстьПраваСклад = ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.ОстаткиТоваров);
	Элементы.ГруппаКарточкаСклад.Видимость = ЕстьПраваСклад;
	Элементы.ГруппаМалоНаСкладе.Видимость = ЕстьПраваСклад;
	Если ЕстьПраваСклад Тогда
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК Количество,
		|	ЕСТЬNULL(СУММА(Остатки.СуммаОстаток), 0) КАК Сумма
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваров.Остатки КАК Остатки");
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Элементы.ДекорацияЗначениеСклад.Заголовок = Формат(Выборка.Количество, "ЧН=0") + НСтр("ru = ' шт.'; zh = ' 件'");
		Элементы.ДекорацияПодписьСклад.Заголовок = СтрШаблон(НСтр("ru = 'на сумму %1 руб.'; zh = '金额 %1 卢布'"), Формат(Выборка.Сумма, "ЧДЦ=0; ЧН=0"));

		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Н.Ссылка КАК Номенклатура,
		|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) - ЕСТЬNULL(Резерв.Количество, 0) КАК Свободно
		|ИЗ
		|	Справочник.Номенклатура КАК Н
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки КАК Остатки
		|		ПО Н.Ссылка = Остатки.Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			Р.Номенклатура КАК Номенклатура,
		|			СУММА(Р.КоличествоОстаток) КАК Количество
		|		ИЗ
		|			РегистрНакопления.ТоварыВРезерве.Остатки КАК Р
		|		СГРУППИРОВАТЬ ПО
		|			Р.Номенклатура) КАК Резерв
		|		ПО Н.Ссылка = Резерв.Номенклатура
		|ГДЕ
		|	НЕ Н.ЭтоГруппа
		|	И НЕ Н.ПометкаУдаления
		|	И ЕСТЬNULL(Остатки.КоличествоОстаток, 0) - ЕСТЬNULL(Резерв.Количество, 0) < 3
		|
		|УПОРЯДОЧИТЬ ПО
		|	Свободно,
		|	Н.Наименование");
		МалоНаСкладе.Загрузить(Запрос.Выполнить().Выгрузить());
	КонецЕсли;

	// Брони: сколько товара в резерве и какие брони активны
	ЕстьПраваБрони = ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.ТоварыВРезерве)
		И ПравоДоступа("Просмотр", Метаданные.Документы.Бронирование);
	Элементы.ГруппаКарточкаРезерв.Видимость = ЕстьПраваБрони;
	Элементы.ГруппаАктивныеБрони.Видимость = ЕстьПраваБрони;
	Если ЕстьПраваБрони Тогда
		Брони = РаботаСБронями.АктивныеБрони();
		АктивныеБрони.Загрузить(Брони);
		Просрочено = Брони.НайтиСтроки(Новый Структура("Просрочена", Истина)).Количество();
		Элементы.ДекорацияЗначениеРезерв.Заголовок = Формат(Брони.Итог("Количество"), "ЧН=0") + НСтр("ru = ' шт.'; zh = ' 件'");
		Элементы.ДекорацияПодписьРезерв.Заголовок = СтрШаблон(НСтр("ru = 'активных броней: %1'; zh = '有效预订：%1'"), Брони.Количество());
		Элементы.ДекорацияПросрочено.Заголовок = ?(Просрочено = 0, "",
			СтрШаблон(НСтр("ru = 'Срок истёк у броней: %1. Свяжитесь с покупателем или отмените бронь.'; zh = '已过期预订：%1。请联系客户或取消预订。'"), Просрочено));
	КонецЕсли;

	// Продажи за текущий месяц
	ЕстьПраваПродажи = ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.Продажи);
	Элементы.ГруппаКарточкаВыручка.Видимость = ЕстьПраваПродажи;
	Элементы.ГруппаКарточкаПрибыль.Видимость = ЕстьПраваПродажи;
	Если ЕстьПраваПродажи Тогда
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Обороты.СуммаОборот), 0) КАК Сумма,
		|	ЕСТЬNULL(СУММА(Обороты.СебестоимостьОборот), 0) КАК Себестоимость,
		|	ЕСТЬNULL(СУММА(Обороты.КоличествоОборот), 0) КАК Количество
		|ИЗ
		|	РегистрНакопления.Продажи.Обороты(&Начало, , , ) КАК Обороты");
		Запрос.УстановитьПараметр("Начало", НачалоМесяца);
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Элементы.ДекорацияЗначениеВыручка.Заголовок = Формат(Выборка.Сумма, "ЧДЦ=0; ЧН=0") + НСтр("ru = ' руб.'; zh = ' 卢布'");
		Элементы.ДекорацияПодписьВыручка.Заголовок = СтрШаблон(НСтр("ru = 'продано %1 шт. с %2'; zh = '自 %2 起已售 %1 件'"), Формат(Выборка.Количество, "ЧН=0"), Формат(НачалоМесяца, "ДФ=dd.MM"));
		Элементы.ДекорацияЗначениеПрибыль.Заголовок = Формат(Выборка.Сумма - Выборка.Себестоимость, "ЧДЦ=0; ЧН=0") + НСтр("ru = ' руб.'; zh = ' 卢布'");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
