
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если ТекущийЯзык() = Метаданные.Языки.Китайский Тогда
		Элементы.ДекорацияБаннер.Картинка = БиблиотекаКартинок.БаннерКитайский;
	КонецЕсли;
	
	ТекущийПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	Имя = ?(ПустаяСтрока(ТекущийПользователь.ПолноеИмя), НСтр("ru = 'коллега'; zh = '同事'"), ТекущийПользователь.ПолноеИмя);
	Элементы.ДекорацияПриветствие.Заголовок = СтрШаблон(НСтр("ru = 'Здравствуйте, %1! Сегодня %2'; zh = '您好，%1！今天是 %2'"),
		Имя, Формат(ТекущаяДатаСеанса(), "ДЛФ=DD"));

	// Кнопки быстрого доступа показываем только тем, у кого есть права
	Элементы.КнопкаНовыйПриход.Видимость = ПравоДоступа("Добавление", Метаданные.Документы.Приход);
	Элементы.КнопкаНоваяПродажа.Видимость = ПравоДоступа("Добавление", Метаданные.Документы.Расход);
	Элементы.КнопкаЦены.Видимость = ПравоДоступа("Просмотр", Метаданные.РегистрыСведений.Цены);
	Элементы.КнопкаОстатки.Видимость = ПравоДоступа("Использование", Метаданные.Отчеты.ОстаткиТоваров);
	Элементы.КнопкаПродажи.Видимость = ПравоДоступа("Использование", Метаданные.Отчеты.Продажи);

	ОбновитьПоказатели();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НовыйПриход(Команда)

	ОткрытьФорму("Документ.Приход.ФормаОбъекта");

КонецПроцедуры

&НаКлиенте
Процедура НоваяПродажа(Команда)

	ОткрытьФорму("Документ.Расход.ФормаОбъекта");

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЦены(Команда)

	ОткрытьФорму("РегистрСведений.Цены.ФормаСписка");

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОстатки(Команда)

	ОткрытьФорму("Отчет.ОстаткиТоваров.Форма", Новый Структура("СформироватьПриОткрытии", Истина));

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПродажи(Команда)

	ОткрытьФорму("Отчет.Продажи.Форма", Новый Структура("СформироватьПриОткрытии", Истина));

КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)

	ОбновитьПоказатели();

КонецПроцедуры

&НаКлиенте
Процедура МалоНаСкладеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Строка = МалоНаСкладе.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Строка <> Неопределено Тогда
		ПоказатьЗначение(, Строка.Номенклатура);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьПоказатели()

	НачалоМесяца = НачалоМесяца(ТекущаяДатаСеанса());

	// Товаров в каталоге
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	Справочник.Номенклатура КАК Н
	|ГДЕ
	|	НЕ Н.ЭтоГруппа
	|	И НЕ Н.ПометкаУдаления");
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Элементы.ДекорацияЗначениеТовары.Заголовок = Формат(Выборка.Количество, "ЧН=0");

	// Склад
	ЕстьПраваСклад = ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.ОстаткиТоваров);
	Элементы.ГруппаКарточкаСклад.Видимость = ЕстьПраваСклад;
	Элементы.ГруппаМалоНаСкладе.Видимость = ЕстьПраваСклад;
	Если ЕстьПраваСклад Тогда
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК Количество,
		|	ЕСТЬNULL(СУММА(Остатки.СуммаОстаток), 0) КАК Сумма
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваров.Остатки КАК Остатки");
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Элементы.ДекорацияЗначениеСклад.Заголовок = Формат(Выборка.Количество, "ЧН=0") + НСтр("ru = ' шт.'; zh = ' 件'");
		Элементы.ДекорацияПодписьСклад.Заголовок = СтрШаблон(НСтр("ru = 'на сумму %1 руб.'; zh = '金额 %1 卢布'"), Формат(Выборка.Сумма, "ЧДЦ=0; ЧН=0"));

		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Н.Ссылка КАК Номенклатура,
		|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК Остаток
		|ИЗ
		|	Справочник.Номенклатура КАК Н
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки КАК Остатки
		|		ПО Н.Ссылка = Остатки.Номенклатура
		|ГДЕ
		|	НЕ Н.ЭтоГруппа
		|	И НЕ Н.ПометкаУдаления
		|	И ЕСТЬNULL(Остатки.КоличествоОстаток, 0) < 3
		|
		|УПОРЯДОЧИТЬ ПО
		|	Остаток,
		|	Н.Наименование");
		МалоНаСкладе.Загрузить(Запрос.Выполнить().Выгрузить());
	КонецЕсли;

	// Продажи за текущий месяц
	ЕстьПраваПродажи = ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.Продажи);
	Элементы.ГруппаКарточкаВыручка.Видимость = ЕстьПраваПродажи;
	Элементы.ГруппаКарточкаПрибыль.Видимость = ЕстьПраваПродажи;
	Если ЕстьПраваПродажи Тогда
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Обороты.СуммаОборот), 0) КАК Сумма,
		|	ЕСТЬNULL(СУММА(Обороты.СебестоимостьОборот), 0) КАК Себестоимость,
		|	ЕСТЬNULL(СУММА(Обороты.КоличествоОборот), 0) КАК Количество
		|ИЗ
		|	РегистрНакопления.Продажи.Обороты(&Начало, , , ) КАК Обороты");
		Запрос.УстановитьПараметр("Начало", НачалоМесяца);
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Элементы.ДекорацияЗначениеВыручка.Заголовок = Формат(Выборка.Сумма, "ЧДЦ=0; ЧН=0") + НСтр("ru = ' руб.'; zh = ' 卢布'");
		Элементы.ДекорацияПодписьВыручка.Заголовок = СтрШаблон(НСтр("ru = 'продано %1 шт. с %2'; zh = '自 %2 起已售 %1 件'"), Формат(Выборка.Количество, "ЧН=0"), Формат(НачалоМесяца, "ДФ=dd.MM"));
		Элементы.ДекорацияЗначениеПрибыль.Заголовок = Формат(Выборка.Сумма - Выборка.Себестоимость, "ЧДЦ=0; ЧН=0") + НСтр("ru = ' руб.'; zh = ' 卢布'");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
