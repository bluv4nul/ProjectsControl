
#Область ПрограммныйИнтерфейс

// Возвращает Истина, если база пустая и её можно заполнить демонстрационными данными.
Функция НужноЗаполнить() Экспорт

	// Заполнять базу может только администратор (или сеанс в базе без пользователей)
	Если Не ПравоДоступа("Администрирование", Метаданные) Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 1 КАК Поле ИЗ Справочник.Номенклатура");
	Возврат Запрос.Выполнить().Пустой();

КонецФункции

// Заполняет пустую базу демонстрационными данными и создаёт пользователей.
Процедура Заполнить() Экспорт

	Если Не НужноЗаполнить() Тогда
		Возврат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Данные = Новый Структура;
		Данные.Вставить("Фото", ФотоИзМакета());
		Данные.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
		Данные.Вставить("Поставщики", Новый Соответствие);
		Данные.Вставить("Покупатели", Новый Соответствие);
		Данные.Вставить("Группы", Новый Соответствие);
		Данные.Вставить("Товары", Новый Соответствие);

		ЗаполнитьСправочники(Данные);
		ЗаполнитьДокументы(Данные);

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	СоздатьПользователей();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СоздатьПользователей()

	Если ПользователиИнформационнойБазы.ПолучитьПользователей().Количество() > 0 Тогда
		Возврат;
	КонецЕсли;

	// Первый пользователь обязательно должен быть администратором
	СоздатьПользователя("Администратор", "Администратор", "ПолныеПрава");
	СоздатьПользователя("Закупщик", "Иванов Иван (закупщик)", "Покупка");
	СоздатьПользователя("Продавец", "Петрова Анна (продавец)", "Продажа");
	// Пользователь с китайским интерфейсом (видит все разделы)
	СоздатьПользователя("Китайский", "中文界面用户（完全权限）", "ПолныеПрава", "Китайский");

КонецПроцедуры

Процедура СоздатьПользователя(Имя, ПолноеИмя, ИмяРоли, ИмяЯзыка = "Русский")

	Пользователь = ПользователиИнформационнойБазы.СоздатьПользователя();
	Пользователь.Имя = Имя;
	Пользователь.ПолноеИмя = ПолноеИмя;
	Пользователь.АутентификацияСтандартная = Истина;
	Пользователь.ПоказыватьВСпискеВыбора = Истина;
	Пользователь.Роли.Добавить(Метаданные.Роли[ИмяРоли]);
	Пользователь.Язык = Метаданные.Языки[ИмяЯзыка];
	Пользователь.Записать();

КонецПроцедуры

Функция ФотоИзМакета()

	Результат = Новый Соответствие;

	ИмяАрхива = ПолучитьИмяВременногоФайла("zip");
	Каталог = ПолучитьИмяВременногоФайла("");
	ПолучитьОбщийМакет("ДемоФото").Записать(ИмяАрхива);

	Архив = Новый ЧтениеZipФайла(ИмяАрхива);
	Архив.ИзвлечьВсе(Каталог, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
	Для Каждого ЭлементАрхива Из Архив.Элементы Цикл
		ПолноеИмя = Каталог + ПолучитьРазделительПути() + ЭлементАрхива.Имя;
		Результат.Вставить(ЭлементАрхива.ИмяБезРасширения, Новый ДвоичныеДанные(ПолноеИмя));
	КонецЦикла;
	Архив.Закрыть();

	УдалитьФайлы(ИмяАрхива);
	УдалитьФайлы(Каталог);

	Возврат Результат;

КонецФункции

Функция НовыйКонтрагент(ИмяСправочника, Наименование, ИНН, Телефон, Почта, Адрес, Дополнительно = "")

	Объект = Справочники[ИмяСправочника].СоздатьЭлемент();
	Объект.Наименование = Наименование;
	Объект.ИНН = ИНН;
	Объект.Телефон = Телефон;
	Объект.ЭлектроннаяПочта = Почта;
	Объект.Адрес = Адрес;
	Если ИмяСправочника = "Поставщики" Тогда
		Объект.КонтактноеЛицо = Дополнительно;
	ИначеЕсли ИмяСправочника = "Покупатели" Тогда
		Объект.ВидПокупателя = ?(Дополнительно = "ЮЛ",
			Перечисления.ВидыПокупателей.ЮридическоеЛицо, Перечисления.ВидыПокупателей.ФизическоеЛицо);
	КонецЕсли;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Функция НоваяГруппа(Наименование)

	Объект = Справочники.Номенклатура.СоздатьГруппу();
	Объект.Наименование = Наименование;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Функция НовыйТовар(Данные, Группа, Наименование, Артикул, Производитель, Гарантия, Описание)

	Объект = Справочники.Номенклатура.СоздатьЭлемент();
	Объект.Родитель = Данные.Группы[Группа];
	Объект.Наименование = Наименование;
	Объект.Артикул = Артикул;
	Объект.Производитель = Производитель;
	Объект.ЕдиницаИзмерения = "шт";
	Объект.ГарантияМес = Гарантия;
	Объект.Описание = Описание;
	Фото = Данные.Фото[Артикул];
	Если Фото <> Неопределено Тогда
		Объект.Фото = Новый ХранилищеЗначения(Фото, Новый СжатиеДанных(9));
	КонецЕсли;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Процедура УстановитьЦену(Данные, Период, Артикул, Цена)

	Запись = РегистрыСведений.Цены.СоздатьМенеджерЗаписи();
	Запись.Период = Период;
	Запись.Номенклатура = Данные.Товары[Артикул];
	Запись.Цена = Цена;
	Запись.Записать();

КонецПроцедуры

// Строки табличной части передаются строкой вида "Артикул:Количество[:Цена];..."
Процедура НовыйДокумент(Данные, ВидДокумента, Дата, Контрагент, Строки, Комментарий = "", Провести = Истина)

	Документ = Документы[ВидДокумента].СоздатьДокумент();
	Документ.Дата = Дата;
	Документ.Организация = Данные.Организация;
	Если ВидДокумента = "Приход" Тогда
		Документ.Поставщик = Данные.Поставщики[Контрагент];
	Иначе
		Документ.Покупатель = Данные.Покупатели[Контрагент];
	КонецЕсли;
	Документ.Комментарий = Комментарий;

	Для Каждого ОписаниеСтроки Из СтрРазделить(Строки, ";", Ложь) Цикл
		Части = СтрРазделить(ОписаниеСтроки, ":");
		Строка = Документ.Товары.Добавить();
		Строка.Номенклатура = Данные.Товары[Части[0]];
		Строка.Количество = Число(Части[1]);
		Если Части.Количество() > 2 Тогда
			Строка.Цена = Число(Части[2]);
		Иначе
			Строка.Цена = РаботаСЦенами.ЦенаНоменклатуры(Строка.Номенклатура, Дата);
		КонецЕсли;
		Строка.Сумма = Строка.Количество * Строка.Цена;
	КонецЦикла;

	Если Провести Тогда
		Документ.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	Иначе
		Документ.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;

КонецПроцедуры

