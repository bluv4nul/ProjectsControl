
#Область ПрограммныйИнтерфейс

// Формирует печатную форму накладной для документов "Приход" и "Расход".
//
// Параметры:
//  Ссылка - ДокументСсылка.Приход, ДокументСсылка.Расход
//
// Возвращаемое значение:
//  ТабличныйДокумент
//
Функция СформироватьНакладную(Ссылка) Экспорт

	ЭтоПриход = ТипЗнч(Ссылка) = Тип("ДокументСсылка.Приход");

	ТД = Новый ТабличныйДокумент;
	ТД.КлючПараметровПечати = "ВольтМаркет_Накладная";
	ТД.ОтображатьСетку = Ложь;
	ТД.ОтображатьЗаголовки = Ложь;

	ЦветШапки = ЦветаСтиля.ЦветОсновной;
	ЦветАкцента = ЦветаСтиля.ЦветАкцент;
	ЦветФона = ЦветаСтиля.ЦветФонаСветлый;
	Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);

	// Ширина колонок: B - №, C - товар, D - артикул, E - количество, F - цена, G - сумма
	ТД.Область(, 1, , 1).ШиринаКолонки = 2;
	ТД.Область(, 2, , 2).ШиринаКолонки = 5;
	ТД.Область(, 3, , 3).ШиринаКолонки = 48;
	ТД.Область(, 4, , 4).ШиринаКолонки = 13;
	ТД.Область(, 5, , 5).ШиринаКолонки = 9;
	ТД.Область(, 6, , 6).ШиринаКолонки = 13;
	ТД.Область(, 7, , 7).ШиринаКолонки = 15;

	// Фирменная полоса
	Обл = ТД.Область(1, 2, 1, 7);
	Обл.Объединить();
	Обл.Текст = НСтр("ru = 'ВольтМаркет — электроника, которая заряжает'; zh = '伏特商城 VoltMarket — 为生活充电的电子产品'");
	Обл.ЦветФона = ЦветШапки;
	Обл.ЦветТекста = WebЦвета.Белый;
	Обл.Шрифт = Новый Шрифт("Arial", 10, Истина);
	Обл.ВысотаСтроки = 22;
	Обл.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
	Обл.Отступ = 1;

	// Заголовок
	Обл = ТД.Область(3, 2, 3, 7);
	Обл.Объединить();
	Обл.Текст = СтрШаблон(НСтр("ru = '%1 № %2 от %3'; zh = '%1 № %2，日期 %3'"),
		?(ЭтоПриход, НСтр("ru = 'Приходная накладная'; zh = '入库单'"), НСтр("ru = 'Расходная накладная'; zh = '发货单'")),
		Ссылка.Номер, Формат(Ссылка.Дата, "ДЛФ=DD"));
	Обл.Шрифт = Новый Шрифт("Arial", 14, Истина);
	Обл.ЦветТекста = ЦветШапки;

	ВывестиРеквизит(ТД, 5, НСтр("ru = 'Организация:'; zh = '公司：'"), Ссылка.Организация);
	Если ЭтоПриход Тогда
		ВывестиРеквизит(ТД, 6, НСтр("ru = 'Поставщик:'; zh = '供应商：'"), Ссылка.Поставщик);
	Иначе
		ВывестиРеквизит(ТД, 6, НСтр("ru = 'Покупатель:'; zh = '客户：'"), Ссылка.Покупатель);
	КонецЕсли;

	// Шапка таблицы
	НомерСтроки = 8;
	Заголовки = СтрРазделить(НСтр("ru = '№,Товар,Артикул,Кол-во,Цена,Сумма'; zh = '序号,商品,货号,数量,价格,金额'"), ",");
	Для Индекс = 0 По Заголовки.ВГраница() Цикл
		Обл = ТД.Область(НомерСтроки, Индекс + 2);
		Обл.Текст = Заголовки[Индекс];
		Обл.ЦветФона = ЦветШапки;
		Обл.ЦветТекста = WebЦвета.Белый;
		Обл.Шрифт = Новый Шрифт("Arial", 10, Истина);
		Обл.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		Обл.Обвести(Линия, Линия, Линия, Линия);
	КонецЦикла;

	// Строки
	Для Каждого Стр Из Ссылка.Товары Цикл
		НомерСтроки = НомерСтроки + 1;
		Значения = Новый Массив;
		Значения.Добавить(Стр.НомерСтроки);
		Значения.Добавить(Строка(Стр.Номенклатура));
		Значения.Добавить(Стр.Номенклатура.Артикул);
		Значения.Добавить(Стр.Количество);
		Значения.Добавить(Стр.Цена);
		Значения.Добавить(Стр.Сумма);
		Для Индекс = 0 По Значения.ВГраница() Цикл
			Обл = ТД.Область(НомерСтроки, Индекс + 2);
			Обл.Текст = ?(Индекс >= 4, Формат(Значения[Индекс], "ЧДЦ=2; ЧН=0,00"), Строка(Значения[Индекс]));
			Обл.Шрифт = Новый Шрифт("Arial", 10);
			Обл.Обвести(Линия, Линия, Линия, Линия);
			Если Индекс <> 1 И Индекс <> 2 Тогда
				Обл.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
			КонецЕсли;
			Если НомерСтроки % 2 = 0 Тогда
				Обл.ЦветФона = ЦветФона;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// Итог
	НомерСтроки = НомерСтроки + 1;
	Обл = ТД.Область(НомерСтроки, 2, НомерСтроки, 6);
	Обл.Объединить();
	Обл.Текст = НСтр("ru = 'Итого:'; zh = '合计：'");
	Обл.Шрифт = Новый Шрифт("Arial", 11, Истина);
	Обл.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
	Обл = ТД.Область(НомерСтроки, 7);
	Обл.Текст = Формат(Ссылка.СуммаДокумента, "ЧДЦ=2; ЧН=0,00");
	Обл.Шрифт = Новый Шрифт("Arial", 11, Истина);
	Обл.ЦветФона = ЦветАкцента;
	Обл.ЦветТекста = WebЦвета.Белый;
	Обл.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
	Обл.Обвести(Линия, Линия, Линия, Линия);

	НомерСтроки = НомерСтроки + 2;
	Обл = ТД.Область(НомерСтроки, 2, НомерСтроки, 7);
	Обл.Объединить();
	Обл.Текст = СтрШаблон(НСтр("ru = 'Всего наименований %1 на сумму %2 руб.'; zh = '共 %1 个品种，金额 %2 卢布'"),
		Ссылка.Товары.Количество(), Формат(Ссылка.СуммаДокумента, "ЧДЦ=2; ЧН=0,00"));
	Обл.Шрифт = Новый Шрифт("Arial", 10, , Истина);

	// Подписи
	НомерСтроки = НомерСтроки + 3;
	ТД.Область(НомерСтроки, 2, НомерСтроки, 3).Объединить();
	ТД.Область(НомерСтроки, 2).Текст = НСтр("ru = 'Отпустил: ____________________'; zh = '发货人：____________________'");
	ТД.Область(НомерСтроки, 4, НомерСтроки, 7).Объединить();
	ТД.Область(НомерСтроки, 4).Текст = НСтр("ru = 'Получил: ____________________'; zh = '收货人：____________________'");

	Возврат ТД;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВывестиРеквизит(ТД, НомерСтроки, Заголовок, Значение)

	Обл = ТД.Область(НомерСтроки, 2, НомерСтроки, 3);
	Обл.Объединить();
	ТД.Область(НомерСтроки, 2).Текст = Заголовок + " " + Строка(Значение);
	ТД.Область(НомерСтроки, 2).Шрифт = Новый Шрифт("Arial", 10);

КонецПроцедуры

#КонецОбласти
