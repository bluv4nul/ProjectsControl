
#Область ПрограммныйИнтерфейс

// Возвращает активные брони (товар ещё в резерве).
//
// Параметры:
//  Покупатель - СправочникСсылка.Покупатели, Неопределено - отбор по покупателю.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Бронирование, Номер, Покупатель, СрокБрони, Количество, Просрочена.
//
Функция АктивныеБрони(Покупатель = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Резерв.Бронирование КАК Бронирование,
	|	Резерв.Бронирование.Номер КАК Номер,
	|	Резерв.Бронирование.Покупатель КАК Покупатель,
	|	Резерв.Бронирование.СрокБрони КАК СрокБрони,
	|	СУММА(Резерв.КоличествоОстаток) КАК Количество,
	|	ВЫБОР
	|		КОГДА Резерв.Бронирование.СрокБрони < &ТекущаяДата
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Просрочена
	|ИЗ
	|	РегистрНакопления.ТоварыВРезерве.Остатки(
	|			,
	|			&ВсеПокупатели
	|				ИЛИ Бронирование.Покупатель = &Покупатель) КАК Резерв
	|
	|СГРУППИРОВАТЬ ПО
	|	Резерв.Бронирование,
	|	Резерв.Бронирование.Номер,
	|	Резерв.Бронирование.Покупатель,
	|	Резерв.Бронирование.СрокБрони
	|
	|ИМЕЮЩИЕ
	|	СУММА(Резерв.КоличествоОстаток) > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	СрокБрони";
	Запрос.УстановитьПараметр("ТекущаяДата", НачалоДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("ВсеПокупатели", Не ЗначениеЗаполнено(Покупатель));
	Запрос.УстановитьПараметр("Покупатель", Покупатель);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Возвращает товары, которые ещё числятся в резерве по брони, с ценами из брони.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номенклатура, Количество, Цена.
//
Функция ТоварыВРезервеПоБрони(Бронирование) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(Т.Цена) КАК Цена,
	|	МИНИМУМ(Т.НомерСтроки) КАК НомерСтроки
	|ПОМЕСТИТЬ ВТ_Цены
	|ИЗ
	|	Документ.Бронирование.Товары КАК Т
	|ГДЕ
	|	Т.Ссылка = &Бронирование
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Резерв.Номенклатура КАК Номенклатура,
	|	Резерв.КоличествоОстаток КАК Количество,
	|	ЕСТЬNULL(Цены.Цена, 0) КАК Цена
	|ИЗ
	|	РегистрНакопления.ТоварыВРезерве.Остатки(, Бронирование = &Бронирование) КАК Резерв
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Цены КАК Цены
	|		ПО Резерв.Номенклатура = Цены.Номенклатура
	|ГДЕ
	|	Резерв.КоличествоОстаток > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЕСТЬNULL(Цены.НомерСтроки, 999)";
	Запрос.УстановитьПараметр("Бронирование", Бронирование);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Возвращает состояние брони.
//
// Возвращаемое значение:
//  Структура - Код (0 черновик, 1 активна, 2 просрочена, 3 выкуплена, 4 отменена, 5 выкуплена частично, 6 активна частично),
//              Представление, Забронировано, Выкуплено, Отменено, ВРезерве.
//
Функция СостояниеБрони(Бронирование) Экспорт

	Результат = Новый Структура("Код, Представление, Забронировано, Выкуплено, Отменено, ВРезерве", 0, "", 0, 0, 0, 0);
	Если Не ЗначениеЗаполнено(Бронирование) Тогда
		Результат.Представление = ПредставлениеСостояния(0);
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|				КОГДА Р.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|					ТОГДА Р.Количество
	|				ИНАЧЕ 0
	|			КОНЕЦ), 0) КАК Забронировано,
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|				КОГДА Р.Регистратор ССЫЛКА Документ.Расход
	|					ТОГДА Р.Количество
	|				ИНАЧЕ 0
	|			КОНЕЦ), 0) КАК Выкуплено,
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|				КОГДА Р.Регистратор ССЫЛКА Документ.ОтменаБронирования
	|					ТОГДА Р.Количество
	|				ИНАЧЕ 0
	|			КОНЕЦ), 0) КАК Отменено
	|ИЗ
	|	РегистрНакопления.ТоварыВРезерве КАК Р
	|ГДЕ
	|	Р.Бронирование = &Бронирование
	|	И Р.Активность";
	Запрос.УстановитьПараметр("Бронирование", Бронирование);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	ЗаполнитьЗначенияСвойств(Результат, Выборка);
	Результат.ВРезерве = Результат.Забронировано - Результат.Выкуплено - Результат.Отменено;

	Реквизиты = Новый Структура("Проведен, СрокБрони");
	Запрос = Новый Запрос("ВЫБРАТЬ Д.Проведен КАК Проведен, Д.СрокБрони КАК СрокБрони ИЗ Документ.Бронирование КАК Д ГДЕ Д.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Бронирование);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Реквизиты, Выборка);
	КонецЕсли;

	Если Не Реквизиты.Проведен Тогда
		Результат.Код = 0;
	ИначеЕсли Результат.ВРезерве > 0 И Реквизиты.СрокБрони < НачалоДня(ТекущаяДатаСеанса()) Тогда
		Результат.Код = 2;
	ИначеЕсли Результат.ВРезерве > 0 И Результат.Выкуплено + Результат.Отменено > 0 Тогда
		Результат.Код = 6;
	ИначеЕсли Результат.ВРезерве > 0 Тогда
		Результат.Код = 1;
	ИначеЕсли Результат.Отменено = 0 Тогда
		Результат.Код = 3;
	ИначеЕсли Результат.Выкуплено = 0 Тогда
		Результат.Код = 4;
	Иначе
		Результат.Код = 5;
	КонецЕсли;
	Результат.Представление = ПредставлениеСостояния(Результат.Код);
	Возврат Результат;

КонецФункции

// Текстовое представление кода состояния брони (см. СостояниеБрони).
Функция ПредставлениеСостояния(Код) Экспорт

	Если Код = 1 Тогда
		Возврат НСтр("ru = 'Активна'; zh = '有效'");
	ИначеЕсли Код = 2 Тогда
		Возврат НСтр("ru = 'Срок истёк'; zh = '已过期'");
	ИначеЕсли Код = 3 Тогда
		Возврат НСтр("ru = 'Выкуплена'; zh = '已购买'");
	ИначеЕсли Код = 4 Тогда
		Возврат НСтр("ru = 'Отменена'; zh = '已取消'");
	ИначеЕсли Код = 5 Тогда
		Возврат НСтр("ru = 'Закрыта (выкуп и отмена)'; zh = '已关闭（部分购买、部分取消）'");
	ИначеЕсли Код = 6 Тогда
		Возврат НСтр("ru = 'Выкуплена частично'; zh = '部分已购买'");
	КонецЕсли;
	Возврат НСтр("ru = 'Черновик (не проведена)'; zh = '草稿（未过账）'");

КонецФункции

// Снимает брони с истёкшим сроком: по каждой проводит документ «Отмена брони» на товары, которые ещё в резерве.
// У частично выкупленной брони снимается только остаток. Повторный запуск ничего не дублирует:
// снятая бронь больше не числится в резерве.
//
// Возвращаемое значение:
//  Структура - Снято (число броней), Документы (массив ссылок на отмены), Ошибки (массив строк).
//
Функция СнятьПросроченныеБрони() Экспорт

	Результат = Новый Структура("Снято, Документы, Ошибки", 0, Новый Массив, Новый Массив);
	УстановитьПривилегированныйРежим(Истина);

	Для Каждого Строка Из АктивныеБрони() Цикл
		Если Не Строка.Просрочена Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Документ = Документы.ОтменаБронирования.СоздатьДокумент();
			Документ.Дата = ТекущаяДатаСеанса();
			Документ.Заполнить(Строка.Бронирование);
			Документ.Причина = ПричинаИстекСрок();
			Документ.Автоматически = Истина;
			Документ.Комментарий = "Снята регламентным заданием «Снятие просроченных броней»";
			Документ.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
			Результат.Снято = Результат.Снято + 1;
			Результат.Документы.Добавить(Документ.Ссылка);
		Исключение
			Результат.Ошибки.Добавить(СтрШаблон("%1: %2", Строка.Бронирование, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Обработчик регламентного задания «Снятие просроченных броней».
Процедура СнятиеПросроченныхБронейПоРасписанию() Экспорт

	Результат = СнятьПросроченныеБрони();
	Комментарий = СтрШаблон("Снято броней: %1", Результат.Снято);
	Если Результат.Ошибки.Количество() > 0 Тогда
		Комментарий = Комментарий + Символы.ПС + СтрСоединить(Результат.Ошибки, Символы.ПС);
	КонецЕсли;
	ЗаписьЖурналаРегистрации("ВольтМаркет.СнятиеПросроченныхБроней",
		?(Результат.Ошибки.Количество() > 0, УровеньЖурналаРегистрации.Ошибка, УровеньЖурналаРегистрации.Информация), , , Комментарий);

	// Ошибка завершает задание аварийно: платформа повторит запуск (до 3 раз через 10 минут)
	Если Результат.Ошибки.Количество() > 0 Тогда
		ВызватьИсключение Комментарий;
	КонецЕсли;

КонецПроцедуры

// Проверяет итоговые остатки после записи движений документа: на складе не должно стать меньше нуля
// и меньше, чем забронировано. Учитываются и документы с более поздними датами.
//
// Параметры:
//  Товары - ТабличнаяЧасть, ТаблицаЗначений - строки с колонкой Номенклатура.
//  Отказ - Булево - устанавливается в Истина при нехватке.
//
Процедура ПроверитьИтоговыеОстатки(Товары, Отказ) Экспорт

	Номенклатура = Новый Массив;
	Для Каждого Стр Из Товары Цикл
		Если ЗначениеЗаполнено(Стр.Номенклатура) И Номенклатура.Найти(Стр.Номенклатура) = Неопределено Тогда
			Номенклатура.Добавить(Стр.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Если Номенклатура.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Номенклатура,
	|	ПРЕДСТАВЛЕНИЕ(Т.Ссылка) КАК НоменклатураПредставление,
	|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК НаСкладе,
	|	ЕСТЬNULL(Резерв.Количество, 0) КАК ВРезерве
	|ИЗ
	|	Справочник.Номенклатура КАК Т
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(, Номенклатура В (&Номенклатура)) КАК Остатки
	|		ПО Т.Ссылка = Остатки.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Р.Номенклатура КАК Номенклатура,
	|			СУММА(Р.КоличествоОстаток) КАК Количество
	|		ИЗ
	|			РегистрНакопления.ТоварыВРезерве.Остатки(, Номенклатура В (&Номенклатура)) КАК Р
	|		СГРУППИРОВАТЬ ПО
	|			Р.Номенклатура) КАК Резерв
	|		ПО Т.Ссылка = Резерв.Номенклатура
	|ГДЕ
	|	Т.Ссылка В (&Номенклатура)
	|	И (ЕСТЬNULL(Остатки.КоличествоОстаток, 0) < 0
	|			ИЛИ ЕСТЬNULL(Остатки.КоличествоОстаток, 0) < ЕСТЬNULL(Резерв.Количество, 0))";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон(НСтр("ru = 'Не хватит товара «%1» с учётом документов более поздними датами: на складе останется %2 шт., а в резерве по броням %3 шт.'; zh = '考虑到日期更晚的单据，商品「%1」将不足：库存将剩 %2 件，而预订中有 %3 件'"),
			Выборка.НоменклатураПредставление, Выборка.НаСкладе, Выборка.ВРезерве);
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЦикла;

КонецПроцедуры

// Блокирует остатки и резерв товаров документа перед изменением движений.
Процедура ЗаблокироватьОстатки(Товары) Экспорт

	Блокировка = Новый БлокировкаДанных;
	Для Каждого ИмяРегистра Из СтрРазделить("ОстаткиТоваров,ТоварыВРезерве", ",") Цикл
		ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления." + ИмяРегистра);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.ИсточникДанных = Товары;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
	КонецЦикла;
	Блокировка.Заблокировать();

КонецПроцедуры

// Причина, с которой регламентное задание снимает брони.
Функция ПричинаИстекСрок() Экспорт

	Возврат "Истёк срок брони";

КонецФункции

// Проверяет, есть ли по брони движения других документов (продажи или отмены).
Функция ЕстьПродажиИлиОтмены(Бронирование) Экспорт

	Если Не ЗначениеЗаполнено(Бронирование) Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	1 КАК Поле
	|ИЗ
	|	РегистрНакопления.ТоварыВРезерве КАК Р
	|ГДЕ
	|	Р.Бронирование = &Бронирование
	|	И Р.Регистратор <> &Бронирование";
	Запрос.УстановитьПараметр("Бронирование", Бронирование);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

#КонецОбласти
