
#Область ПрограммныйИнтерфейс

// Возвращает действующую цену продажи товара на дату из регистра сведений "Цены".
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура
//  Дата - Дата - если не указана, берётся текущая дата.
//
// Возвращаемое значение:
//  Число - цена (0, если цена не установлена).
//
Функция ЦенаНоменклатуры(Номенклатура, Дата = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат 0;
	КонецЕсли;

	ДатаЦены = ?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса());
	Срез = РегистрыСведений.Цены.ПолучитьПоследнее(ДатаЦены, Новый Структура("Номенклатура", Номенклатура));
	Возврат Срез.Цена;

КонецФункции

// Возвращает текущий остаток товара на складе (в штуках).
Функция ОстатокНоменклатуры(Номенклатура) Экспорт

	Если Не ЗначениеЗаполнено(Номенклатура)
		Или Не ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.ОстаткиТоваров) Тогда
		Возврат 0;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(, Номенклатура = &Номенклатура) КАК Остатки";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Количество, 0);

КонецФункции

#КонецОбласти
