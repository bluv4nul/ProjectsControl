
#Область ПрограммныйИнтерфейс

// Возвращает действующую цену продажи товара на дату из регистра сведений "Цены".
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура
//  Дата - Дата - если не указана, берётся текущая дата.
//
// Возвращаемое значение:
//  Число - цена (0, если цена не установлена).
//
Функция ЦенаНоменклатуры(Номенклатура, Дата = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат 0;
	КонецЕсли;

	ДатаЦены = ?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса());
	Срез = РегистрыСведений.Цены.ПолучитьПоследнее(ДатаЦены, Новый Структура("Номенклатура", Номенклатура));
	Возврат Срез.Цена;

КонецФункции

// Возвращает текущий остаток товара на складе (в штуках).
Функция ОстатокНоменклатуры(Номенклатура) Экспорт

	Если Не ЗначениеЗаполнено(Номенклатура)
		Или Не ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.ОстаткиТоваров) Тогда
		Возврат 0;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(, Номенклатура = &Номенклатура) КАК Остатки";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Количество, 0);

КонецФункции

// Возвращает остатки товара с учётом броней.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура
//  Бронирование - ДокументСсылка.Бронирование - резерв этой брони считается доступным (для продажи по брони).
//
// Возвращаемое значение:
//  Структура - НаСкладе, ВРезерве, ВРезервеПоБрони, Свободно (НаСкладе - ВРезерве), Доступно (Свободно + ВРезервеПоБрони).
//
Функция ОстаткиТовара(Номенклатура, Бронирование = Неопределено) Экспорт

	Результат = Новый Структура("НаСкладе, ВРезерве, ВРезервеПоБрони, Свободно, Доступно", 0, 0, 0, 0, 0);
	Если Не ЗначениеЗаполнено(Номенклатура)
		Или Не ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.ОстаткиТоваров)
		Или Не ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.ТоварыВРезерве) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК Количество
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(, Номенклатура = &Номенклатура) КАК Остатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Резерв.КоличествоОстаток), 0) КАК Всего,
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|				КОГДА Резерв.Бронирование = &Бронирование
	|					ТОГДА Резерв.КоличествоОстаток
	|				ИНАЧЕ 0
	|			КОНЕЦ), 0) КАК ПоБрони
	|ИЗ
	|	РегистрНакопления.ТоварыВРезерве.Остатки(, Номенклатура = &Номенклатура) КАК Резерв";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Бронирование", ?(ЗначениеЗаполнено(Бронирование), Бронирование, Документы.Бронирование.ПустаяСсылка()));
	Пакет = Запрос.ВыполнитьПакет();

	Выборка = Пакет[0].Выбрать();
	Выборка.Следующий();
	Результат.НаСкладе = Выборка.Количество;
	Выборка = Пакет[1].Выбрать();
	Выборка.Следующий();
	Результат.ВРезерве = Выборка.Всего;
	Результат.ВРезервеПоБрони = Выборка.ПоБрони;
	Результат.Свободно = Результат.НаСкладе - Результат.ВРезерве;
	Результат.Доступно = Результат.Свободно + Результат.ВРезервеПоБрони;
	Возврат Результат;

КонецФункции

// Возвращает цену из последнего проведённого поступления товара (0, если поступлений не было).
Функция ПоследняяЦенаЗакупки(Номенклатура) Экспорт

	Если Не ЗначениеЗаполнено(Номенклатура) Или Не ПравоДоступа("Чтение", Метаданные.Документы.Приход) Тогда
		Возврат 0;
	КонецЕсли;
	Цены = ЦеныЗакупки(Номенклатура);
	Цена = Цены.Получить(Номенклатура);
	Возврат ?(Цена = Неопределено, 0, Цена);

КонецФункции

// Возвращает соответствие "товар -> цена последнего поступления".
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура, Неопределено - один товар или все товары.
//
Функция ЦеныЗакупки(Номенклатура = Неопределено) Экспорт

	Результат = Новый Соответствие;
	Если Не ПравоДоступа("Чтение", Метаданные.Документы.Приход) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(Т.Ссылка.Дата) КАК Дата
	|ПОМЕСТИТЬ ВТ_Даты
	|ИЗ
	|	Документ.Приход.Товары КАК Т
	|ГДЕ
	|	Т.Ссылка.Проведен
	|	И (&ВсеТовары
	|			ИЛИ Т.Номенклатура = &Номенклатура)
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(Т.Цена) КАК Цена
	|ИЗ
	|	Документ.Приход.Товары КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Даты КАК Д
	|		ПО Т.Номенклатура = Д.Номенклатура
	|			И Т.Ссылка.Дата = Д.Дата
	|ГДЕ
	|	Т.Ссылка.Проведен
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.Номенклатура";
	Запрос.УстановитьПараметр("ВсеТовары", Номенклатура = Неопределено);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Номенклатура, Выборка.Цена);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Цена для строки документа: в продаже и брони - цена продажи по прайсу, в поступлении - цена последней закупки.
Функция ЦенаДляДокумента(Номенклатура, Режим, Дата = Неопределено) Экспорт

	Если Режим = "Закупка" Тогда
		Возврат ПоследняяЦенаЗакупки(Номенклатура);
	КонецЕсли;
	Возврат ЦенаНоменклатуры(Номенклатура, Дата);

КонецФункции

// Ищет товары по артикулу (точное совпадение) или по части наименования.
//
// Возвращаемое значение:
//  Массив - найденные товары (СправочникСсылка.Номенклатура).
//
Функция НайтиТовары(Знач Текст) Экспорт

	Текст = СокрЛП(Текст);
	Результат = Новый Массив;
	Если ПустаяСтрока(Текст) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 20
	|	Н.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА Н.Артикул = &Текст
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Порядок
	|ИЗ
	|	Справочник.Номенклатура КАК Н
	|ГДЕ
	|	НЕ Н.ЭтоГруппа
	|	И НЕ Н.ПометкаУдаления
	|	И (Н.Артикул = &Текст
	|			ИЛИ Н.Наименование ПОДОБНО &Шаблон
	|			ИЛИ Н.Артикул ПОДОБНО &Шаблон)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	Н.Наименование";
	Запрос.УстановитьПараметр("Текст", Текст);
	Запрос.УстановитьПараметр("Шаблон", "%" + СтрЗаменить(СтрЗаменить(Текст, "%", ""), "_", "") + "%");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Порядок = 0 Тогда
			// точное совпадение артикула - других вариантов не нужно
			Результат.Очистить();
			Результат.Добавить(Выборка.Ссылка);
			Прервать;
		КонецЕсли;
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Описание товара для карточки в формах документов: наименование, цена и остатки.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура
//  Режим - Строка - "Закупка", "Продажа" или "Бронь".
//  Дата - Дата - дата цены.
//  Бронирование - ДокументСсылка.Бронирование - бронь, резерв которой доступен.
//
// Возвращаемое значение:
//  Структура - Наименование, ТекстЦены, ТекстОстатка, Фото (ДвоичныеДанные или Неопределено), Доступно.
//
Функция ОписаниеТовара(Номенклатура, Режим, Дата = Неопределено, Бронирование = Неопределено) Экспорт

	Результат = Новый Структура("Наименование, ТекстЦены, ТекстОстатка, Фото, Доступно",
		НСтр("ru = 'Выберите строку с товаром'; zh = '请选择商品行'"), "", "", Неопределено, 0);
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Наименование = Строка(Номенклатура);
	Результат.Фото = Номенклатура.Фото.Получить();
	Цена = ЦенаДляДокумента(Номенклатура, Режим, Дата);
	ФорматЦены = "ЧДЦ=2; ЧН=" + НСтр("ru = 'не установлена'; zh = '未设置'");
	Если Режим = "Закупка" Тогда
		Результат.ТекстЦены = СтрШаблон(НСтр("ru = 'Последняя закупка: %1 руб.'; zh = '最近进价：%1 卢布'"), Формат(Цена, ФорматЦены));
	Иначе
		Результат.ТекстЦены = СтрШаблон(НСтр("ru = 'Цена продажи: %1 руб.'; zh = '售价：%1 卢布'"), Формат(Цена, ФорматЦены));
	КонецЕсли;

	Остатки = ОстаткиТовара(Номенклатура, Бронирование);
	Результат.Доступно = Остатки.Доступно;
	Текст = СтрШаблон(НСтр("ru = 'На складе: %1 шт.
		|В резерве: %2 шт.
		|Свободно: %3 шт.'; zh = '库存：%1 件
		|已预订：%2 件
		|可售：%3 件'"),
		Формат(Остатки.НаСкладе, "ЧН=0"), Формат(Остатки.ВРезерве, "ЧН=0"), Формат(Остатки.Свободно, "ЧН=0"));
	Если Остатки.ВРезервеПоБрони > 0 Тогда
		Текст = Текст + СтрШаблон(НСтр("ru = ' + %1 по этой брони'; zh = ' + 本预订 %1 件'"), Формат(Остатки.ВРезервеПоБрони, "ЧН=0"));
	КонецЕсли;
	Результат.ТекстОстатка = Текст;
	Возврат Результат;

КонецФункции

#КонецОбласти
