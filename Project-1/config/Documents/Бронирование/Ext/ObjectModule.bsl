
#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Организация) Тогда
		Выборка = Справочники.Организации.Выбрать();
		Если Выборка.Следующий() Тогда
			Организация = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;

	Если ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.Покупатели") Тогда
		Покупатель = ДанныеЗаполнения;
	КонецЕсли;

	// По умолчанию бронь действует три дня
	Если Не ЗначениеЗаполнено(СрокБрони) Тогда
		СрокБрони = НачалоДня(?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса())) + 3 * 86400;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	ДатаБрони = ?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса());
	Если ЗначениеЗаполнено(СрокБрони) И СрокБрони < НачалоДня(ДатаБрони) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Срок брони не может быть раньше даты документа'; zh = '预订期限不能早于单据日期'");
		Сообщение.Поле = "СрокБрони";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Для Каждого Стр Из Товары Цикл
		Стр.Сумма = Стр.Количество * Стр.Цена;
	КонецЦикла;
	СуммаДокумента = Товары.Итог("Сумма");

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)

	// Бронь, по которой уже были продажи или отмена, менять нельзя: иначе резерв уйдёт в минус
	Если ЗапретИзменения() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	// Очищаем старые движения, чтобы они не влияли на проверку при перепроведении
	Движения.ТоварыВРезерве.Записывать = Истина;
	Движения.ТоварыВРезерве.Записать();

	Блокировка = Новый БлокировкаДанных;
	Для Каждого ИмяРегистра Из СтрРазделить("ОстаткиТоваров,ТоварыВРезерве", ",") Цикл
		ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления." + ИмяРегистра);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.ИсточникДанных = Товары;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
	КонецЦикла;
	Блокировка.Заблокировать();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТЧ.Номенклатура КАК Номенклатура,
	|	СУММА(ТЧ.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	Документ.Бронирование.Товары КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ТЧ.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Номенклатура КАК Номенклатура,
	|	ПРЕДСТАВЛЕНИЕ(ВТ.Номенклатура) КАК НоменклатураПредставление,
	|	ВТ.Количество КАК Количество,
	|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК НаСкладе,
	|	ЕСТЬNULL(Резерв.Количество, 0) КАК ВРезерве
	|ИЗ
	|	ВТ_Товары КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(
	|				&МоментВремени,
	|				Номенклатура В
	|					(ВЫБРАТЬ
	|						Т.Номенклатура
	|					ИЗ
	|						ВТ_Товары КАК Т)) КАК Остатки
	|		ПО ВТ.Номенклатура = Остатки.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Р.Номенклатура КАК Номенклатура,
	|			СУММА(Р.КоличествоОстаток) КАК Количество
	|		ИЗ
	|			РегистрНакопления.ТоварыВРезерве.Остатки(
	|					&МоментВремени,
	|					Номенклатура В
	|						(ВЫБРАТЬ
	|							Т.Номенклатура
	|						ИЗ
	|							ВТ_Товары КАК Т)) КАК Р
	|		СГРУППИРОВАТЬ ПО
	|			Р.Номенклатура) КАК Резерв
	|		ПО ВТ.Номенклатура = Резерв.Номенклатура";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("МоментВремени", Новый Граница(МоментВремени(), ВидГраницы.Исключая));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		// Забронировать можно только свободный остаток: товар на складе минус уже забронированный другими
		Свободно = Выборка.НаСкладе - Выборка.ВРезерве;
		Если Выборка.Количество > Свободно Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон(НСтр("ru = 'Нельзя забронировать «%1»: требуется %2 шт., свободно %3 шт. (на складе %4 шт., уже в резерве %5 шт.)'; zh = '无法预订「%1」：需要 %2 件，可售 %3 件（库存 %4 件，已预订 %5 件）'"),
				Выборка.НоменклатураПредставление, Выборка.Количество, Макс(Свободно, 0), Выборка.НаСкладе, Выборка.ВРезерве);
			Сообщение.Сообщить();
			Отказ = Истина;
			Продолжить;
		КонецЕсли;

		Движение = Движения.ТоварыВРезерве.ДобавитьПриход();
		Движение.Период = Дата;
		Движение.Номенклатура = Выборка.Номенклатура;
		Движение.Бронирование = Ссылка;
		Движение.Количество = Выборка.Количество;

	КонецЦикла;

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)

	Если ЗапретИзменения() Тогда
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗапретИзменения()

	Если Не РаботаСБронями.ЕстьПродажиИлиОтмены(Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = НСтр("ru = 'По этой брони уже оформлены продажа или отмена — изменить или отменить проведение брони нельзя. Чтобы освободить оставшийся товар, оформите «Отмену брони».'; zh = '该预订已有销售或取消记录，无法修改或取消过账。如需释放剩余商品，请办理「取消预订」。'");
	Сообщение.Сообщить();
	Возврат Истина;

КонецФункции

#КонецОбласти
