	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	Док.Ссылка КАК Ссылка,
	Док.Дата КАК Дата,
	Док.Номер КАК Номер,
	Док.Проведен КАК Проведен,
	Док.ПометкаУдаления КАК ПометкаУдаления,
	Док.Покупатель КАК Покупатель,
	Док.СрокБрони КАК СрокБрони,
	Док.СуммаДокумента КАК СуммаДокумента,
	Док.Комментарий КАК Комментарий,
	ЕСТЬNULL(Движения.ВРезерве, 0) КАК ВРезерве,
	ВЫБОР
		КОГДА НЕ Док.Проведен
			ТОГДА 0
		КОГДА ЕСТЬNULL(Движения.ВРезерве, 0) &gt; 0
				И Док.СрокБрони &lt; &amp;ТекущаяДата
			ТОГДА 2
		КОГДА ЕСТЬNULL(Движения.ВРезерве, 0) &gt; 0
			ТОГДА 1
		КОГДА ЕСТЬNULL(Движения.Отменено, 0) = 0
			ТОГДА 3
		КОГДА ЕСТЬNULL(Движения.Выкуплено, 0) = 0
			ТОГДА 4
		ИНАЧЕ 5
	КОНЕЦ КАК КодСостояния,
	ВЫБОР
		КОГДА НЕ Док.Проведен
			ТОГДА &amp;Состояние0
		КОГДА ЕСТЬNULL(Движения.ВРезерве, 0) &gt; 0
				И Док.СрокБрони &lt; &amp;ТекущаяДата
			ТОГДА &amp;Состояние2
		КОГДА ЕСТЬNULL(Движения.ВРезерве, 0) &gt; 0
				И ЕСТЬNULL(Движения.Выкуплено, 0) + ЕСТЬNULL(Движения.Отменено, 0) &gt; 0
			ТОГДА &amp;Состояние6
		КОГДА ЕСТЬNULL(Движения.ВРезерве, 0) &gt; 0
			ТОГДА &amp;Состояние1
		КОГДА ЕСТЬNULL(Движения.Отменено, 0) = 0
			ТОГДА &amp;Состояние3
		КОГДА ЕСТЬNULL(Движения.Выкуплено, 0) = 0
			ТОГДА &amp;Состояние4
		ИНАЧЕ &amp;Состояние5
	КОНЕЦ КАК Состояние
ИЗ
	Документ.Бронирование КАК Док
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			Р.Бронирование КАК Бронирование,
			СУММА(ВЫБОР
					КОГДА Р.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
						ТОГДА Р.Количество
					ИНАЧЕ -Р.Количество
				КОНЕЦ) КАК ВРезерве,
			СУММА(ВЫБОР
					КОГДА Р.Регистратор ССЫЛКА Документ.Расход
						ТОГДА Р.Количество
					ИНАЧЕ 0
				КОНЕЦ) КАК Выкуплено,
			СУММА(ВЫБОР
					КОГДА Р.Регистратор ССЫЛКА Документ.ОтменаБронирования
						ТОГДА Р.Количество
					ИНАЧЕ 0
				КОНЕЦ) КАК Отменено
		ИЗ
			РегистрНакопления.ТоварыВРезерве КАК Р
		ГДЕ
			Р.Активность
		СГРУППИРОВАТЬ ПО
			Р.Бронирование) КАК Движения
		ПО Док.Ссылка = Движения.Бронирование</QueryText>
				<MainTable>Document.Бронирование</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
		</Attribute>
	</Attributes>
