
#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.Бронирование") Тогда
		Бронирование = ДанныеЗаполнения;
		ЗаполнитьПоБрони();
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)

	Движения.ТоварыВРезерве.Записывать = Истина;
	Движения.ТоварыВРезерве.Записать();

	Если Не Бронирование.Проведен Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Бронь не проведена — отменять нечего'; zh = '预订未过账，无需取消'");
		Сообщение.Поле = "Бронирование";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ТоварыВРезерве");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Бронирование", Бронирование);
	Блокировка.Заблокировать();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТЧ.Номенклатура КАК Номенклатура,
	|	СУММА(ТЧ.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	Документ.ОтменаБронирования.Товары КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ТЧ.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Номенклатура КАК Номенклатура,
	|	ПРЕДСТАВЛЕНИЕ(ВТ.Номенклатура) КАК НоменклатураПредставление,
	|	ВТ.Количество КАК Количество,
	|	ЕСТЬNULL(Резерв.КоличествоОстаток, 0) КАК ВРезерве
	|ИЗ
	|	ВТ_Товары КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезерве.Остатки(&МоментВремени, Бронирование = &Бронирование) КАК Резерв
	|		ПО ВТ.Номенклатура = Резерв.Номенклатура";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Бронирование", Бронирование);
	Запрос.УстановитьПараметр("МоментВремени", Новый Граница(МоментВремени(), ВидГраницы.Исключая));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Если Выборка.Количество > Выборка.ВРезерве Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон(НСтр("ru = 'По брони в резерве только %2 шт. товара «%1» — снять с брони %3 шт. нельзя'; zh = '该预订中「%1」仅有 %2 件，无法取消 %3 件'"),
				Выборка.НоменклатураПредставление, Выборка.ВРезерве, Выборка.Количество);
			Сообщение.Сообщить();
			Отказ = Истина;
			Продолжить;
		КонецЕсли;

		// Снятие с брони возвращает товар в свободный остаток
		Движение = Движения.ТоварыВРезерве.ДобавитьРасход();
		Движение.Период = Дата;
		Движение.Номенклатура = Выборка.Номенклатура;
		Движение.Бронирование = Бронирование;
		Движение.Количество = Выборка.Количество;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет табличную часть товарами, которые ещё числятся в резерве по брони.
Процедура ЗаполнитьПоБрони() Экспорт

	Товары.Очистить();
	Если Не ЗначениеЗаполнено(Бронирование) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Стр Из РаботаСБронями.ТоварыВРезервеПоБрони(Бронирование) Цикл
		ЗаполнитьЗначенияСвойств(Товары.Добавить(), Стр, "Номенклатура, Количество");
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
