
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбновитьЗаголовок();
	ОбновитьОписаниеБрони();

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	ОбновитьЗаголовок();
	ОбновитьОписаниеБрони();

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	Оповестить("ВольтМаркет_ИзмененыОстатки");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура БронированиеПриИзменении(Элемент)

	ЗаполнитьПоБрониНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьПоБрониНаСервере()

	Документ = РеквизитФормыВЗначение("Объект");
	Документ.ЗаполнитьПоБрони();
	ЗначениеВРеквизитФормы(Документ, "Объект");
	ОбновитьОписаниеБрони();

КонецПроцедуры

&НаСервере
Процедура ОбновитьОписаниеБрони()

	Если Не ЗначениеЗаполнено(Объект.Бронирование) Тогда
		Элементы.ДекорацияБронь.Заголовок = НСтр("ru = 'Выберите бронь — товары, которые ещё в резерве, заполнятся автоматически'; zh = '请选择预订 — 仍在预留中的商品将自动填入'");
		Возврат;
	КонецЕсли;
	Состояние = РаботаСБронями.СостояниеБрони(Объект.Бронирование);
	Элементы.ДекорацияБронь.Заголовок = СтрШаблон(НСтр("ru = 'Покупатель: %1 • действует до %2 • %3 • в резерве %4 шт.'; zh = '客户：%1 • 有效期至 %2 • %3 • 预留 %4 件'"),
		Объект.Бронирование.Покупатель, Формат(Объект.Бронирование.СрокБрони, "ДЛФ=D"), НРег(Состояние.Представление), Состояние.ВРезерве);

КонецПроцедуры

&НаСервере
Процедура ОбновитьЗаголовок()

	Если Объект.Ссылка.Пустая() Тогда
		Элементы.ДекорацияЗаголовок.Заголовок = НСтр("ru = 'Новая отмена брони'; zh = '新建取消预订'");
	Иначе
		Элементы.ДекорацияЗаголовок.Заголовок = СтрШаблон(НСтр("ru = 'Отмена брони № %1 от %2'; zh = '取消预订 № %1，日期 %2'"),
			Объект.Номер, Формат(Объект.Дата, "ДЛФ=D"));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
