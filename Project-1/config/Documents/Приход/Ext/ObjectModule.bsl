
#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Организация) Тогда
		Выборка = Справочники.Организации.Выбрать();
		Если Выборка.Следующий() Тогда
			Организация = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;

	Если ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.Поставщики") Тогда
		Поставщик = ДанныеЗаполнения;
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Для Каждого Стр Из Товары Цикл
		Стр.Сумма = Стр.Количество * Стр.Цена;
	КонецЦикла;
	СуммаДокумента = Товары.Итог("Сумма");

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)

	ТоварыДокумента = ТоварыДляБлокировки();
	РаботаСБронями.ЗаблокироватьОстатки(ТоварыДокумента);

	// Поступление увеличивает остатки товаров на складе
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.ОстаткиТоваров.Очистить();
	Для Каждого Стр Из Товары Цикл
		Движение = Движения.ОстаткиТоваров.ДобавитьПриход();
		Движение.Период = Дата;
		Движение.Номенклатура = Стр.Номенклатура;
		Движение.Количество = Стр.Количество;
		Движение.Сумма = Стр.Сумма;
	КонецЦикла;

	// При перепроведении с меньшим количеством товар мог уже уйти в продажи и брони
	Движения.ОстаткиТоваров.Записать();
	РаботаСБронями.ПроверитьИтоговыеОстатки(ТоварыДокумента, Отказ);

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)

	// Нельзя отменить поступление товара, который уже продан или забронирован
	ТоварыДокумента = ТоварыДляБлокировки();
	РаботаСБронями.ЗаблокироватьОстатки(ТоварыДокумента);
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.ОстаткиТоваров.Очистить();
	Движения.ОстаткиТоваров.Записать();
	РаботаСБронями.ПроверитьИтоговыеОстатки(ТоварыДокумента, Отказ);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Товары документа вместе с товарами прежних движений (при перепроведении состав мог измениться).
Функция ТоварыДляБлокировки()

	Результат = Товары.Выгрузить(, "Номенклатура");
	Если Не Ссылка.Пустая() Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ Д.Номенклатура КАК Номенклатура ИЗ РегистрНакопления.ОстаткиТоваров КАК Д ГДЕ Д.Регистратор = &Ссылка");
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Добавить().Номенклатура = Выборка.Номенклатура;
		КонецЦикла;
	КонецЕсли;
	Результат.Свернуть("Номенклатура");
	Возврат Результат;

КонецФункции

#КонецОбласти
