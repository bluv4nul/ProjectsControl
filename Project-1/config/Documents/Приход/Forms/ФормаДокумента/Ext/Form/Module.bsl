
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбновитьЗаголовок();
	Если Параметры.ЗаполнитьДефицитом И Объект.Ссылка.Пустая() Тогда
		ЗаполнитьДефицитом();
	КонецЕсли;
	ОбновитьКарточкуНаСервере(?(Объект.Товары.Количество() > 0, Объект.Товары[0].Номенклатура, Неопределено));

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	ОбновитьЗаголовок();

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	Оповестить("ВольтМаркет_ИзмененыОстатки");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

&НаКлиенте
Процедура ТоварыСуммаПриИзменении(Элемент)

	Строка = Элементы.Товары.ТекущиеДанные;
	Если Строка <> Неопределено И Строка.Количество <> 0 Тогда
		Строка.Цена = Окр(Строка.Сумма / Строка.Количество, 2);
	КонецЕсли;
	ОбновитьИтог();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Дозаказ(Команда)

	Если ЗаполнитьДефицитом() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Все товары есть в достаточном количестве — дозаказывать нечего.'; zh = '所有商品库存充足，无需补货。'"));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Добавляет товары, свободный остаток которых меньше 3 шт., в количестве до 5 шт. по цене последней закупки.
&НаСервере
Функция ЗаполнитьДефицитом()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Н.Ссылка КАК Номенклатура,
	|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) - ЕСТЬNULL(Резерв.Количество, 0) КАК Свободно
	|ИЗ
	|	Справочник.Номенклатура КАК Н
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки КАК Остатки
	|		ПО Н.Ссылка = Остатки.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Р.Номенклатура КАК Номенклатура,
	|			СУММА(Р.КоличествоОстаток) КАК Количество
	|		ИЗ
	|			РегистрНакопления.ТоварыВРезерве.Остатки КАК Р
	|		СГРУППИРОВАТЬ ПО
	|			Р.Номенклатура) КАК Резерв
	|		ПО Н.Ссылка = Резерв.Номенклатура
	|ГДЕ
	|	НЕ Н.ЭтоГруппа
	|	И НЕ Н.ПометкаУдаления
	|	И ЕСТЬNULL(Остатки.КоличествоОстаток, 0) - ЕСТЬNULL(Резерв.Количество, 0) < 3
	|
	|УПОРЯДОЧИТЬ ПО
	|	Н.Наименование";
	Цены = РаботаСЦенами.ЦеныЗакупки();
	Добавлено = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Объект.Товары.НайтиСтроки(Новый Структура("Номенклатура", Выборка.Номенклатура)).Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		Цена = Цены.Получить(Выборка.Номенклатура);
		ДобавитьТовар(Выборка.Номенклатура, 5 - Макс(Выборка.Свободно, 0), ?(Цена = Неопределено, 0, Цена));
		Добавлено = Добавлено + 1;
	КонецЦикла;
	Возврат Добавлено;

КонецФункции

&НаСервере
Процедура ОбновитьЗаголовок()

	Если Объект.Ссылка.Пустая() Тогда
		Элементы.ДекорацияЗаголовок.Заголовок = НСтр("ru = 'Новое поступление товаров'; zh = '新建商品入库'");
	Иначе
		Элементы.ДекорацияЗаголовок.Заголовок = СтрШаблон(НСтр("ru = 'Поступление товаров № %1 от %2'; zh = '商品入库 № %1，日期 %2'"),
			Объект.Номер, Формат(Объект.Дата, "ДЛФ=D"));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ЗаголовокПечати()

	Возврат НСтр("ru = 'Приходная накладная № '; zh = '入库单 № '");

КонецФункции

#КонецОбласти

#Область ОбщиеПроцедурыФормДокументов
// Общие процедуры форм документов с табличной частью «Товары» (поступление, продажа, бронь):
// быстрый ввод по артикулу, подбор товаров, карточка текущего товара, пересчёт сумм.

&НаКлиентеНаСервереБезКонтекста
Функция РежимПодбора()

	Возврат "Закупка";

КонецФункции

&НаКлиенте
Процедура БыстрыйВводПриИзменении(Элемент) Экспорт

	Если ПустаяСтрока(БыстрыйВвод) Тогда
		Возврат;
	КонецЕсли;
	ИдентификаторСтроки = ДобавитьПоСтрокеПоиска(БыстрыйВвод);
	БыстрыйВвод = "";
	Если ИдентификаторСтроки <> Неопределено Тогда
		Элементы.Товары.ТекущаяСтрока = ИдентификаторСтроки;
		ОбновитьКарточку();
	КонецЕсли;
	ТекущийЭлемент = Элементы.БыстрыйВвод;

КонецПроцедуры

&НаСервере
Функция ДобавитьПоСтрокеПоиска(Текст)

	Найденные = РаботаСЦенами.НайтиТовары(Текст);
	Если Найденные.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон(НСтр("ru = 'Товар «%1» не найден. Проверьте артикул или откройте «Подбор товаров».'; zh = '未找到商品「%1」。请检查货号或打开「选择商品」。'"), Текст);
		Сообщение.Сообщить();
		Возврат Неопределено;
	ИначеЕсли Найденные.Количество() > 1 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон(НСтр("ru = 'По запросу «%1» найдено товаров: %2. Уточните запрос (лучше ввести артикул) или откройте «Подбор товаров».'; zh = '按「%1」找到 %2 个商品。请输入更准确的内容（最好是货号）或打开「选择商品」。'"),
			Текст, Найденные.Количество());
		Сообщение.Сообщить();
		Возврат Неопределено;
	КонецЕсли;
	Возврат ДобавитьТовар(Найденные[0], 1);

КонецФункции

// Добавляет товар в табличную часть; если товар уже есть - увеличивает количество. Возвращает идентификатор строки.
&НаСервере
Функция ДобавитьТовар(Номенклатура, Количество, Цена = Неопределено)

	Строки = Объект.Товары.НайтиСтроки(Новый Структура("Номенклатура", Номенклатура));
	Если Строки.Количество() > 0 Тогда
		Строка = Строки[0];
	Иначе
		Строка = Объект.Товары.Добавить();
		Строка.Номенклатура = Номенклатура;
		Строка.Цена = ?(Цена = Неопределено, РаботаСЦенами.ЦенаДляДокумента(Номенклатура, РежимПодбора(), Объект.Дата), Цена);
	КонецЕсли;
	Строка.Количество = Строка.Количество + Количество;
	Строка.Сумма = Строка.Количество * Строка.Цена;
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма");
	Модифицированность = Истина;
	Возврат Строка.ПолучитьИдентификатор();

КонецФункции

&НаКлиенте
Процедура Подбор(Команда) Экспорт

	Параметры = Новый Структура("Режим, Дата", РежимПодбора(), Объект.Дата);
	Если РежимПодбора() = "Продажа" Тогда
		Параметры.Вставить("Бронирование", Объект.Бронирование);
	ИначеЕсли РежимПодбора() = "Бронь" И ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Параметры.Вставить("Бронирование", Объект.Ссылка);
	КонецЕсли;
	ОткрытьФорму("ОбщаяФорма.ПодборТоваров", Параметры, ЭтаФорма, , , ,
		Новый ОписаниеОповещения("ПодборЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ПодборЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(Результат) <> Тип("Массив") Или Результат.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ИдентификаторСтроки = ПеренестиПодбор(Результат);
	Если ИдентификаторСтроки <> Неопределено Тогда
		Элементы.Товары.ТекущаяСтрока = ИдентификаторСтроки;
		ОбновитьКарточку();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПеренестиПодбор(Выбранные)

	ИдентификаторСтроки = Неопределено;
	Для Каждого Выбранный Из Выбранные Цикл
		ИдентификаторСтроки = ДобавитьТовар(Выбранный.Номенклатура, Выбранный.Количество, Выбранный.Цена);
	КонецЦикла;
	Возврат ИдентификаторСтроки;

КонецФункции

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)

	Строка = Элементы.Товары.ТекущиеДанные;
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Строка.Цена = ЦенаТовара(Строка.Номенклатура, РежимПодбора(), Объект.Дата);
	Если Строка.Количество = 0 Тогда
		Строка.Количество = 1;
	КонецЕсли;
	РассчитатьСуммуСтроки();
	ОбновитьКарточку();

КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)

	РассчитатьСуммуСтроки();

КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)

	РассчитатьСуммуСтроки();

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПослеУдаления(Элемент)

	ОбновитьИтог();

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ОбновитьКарточку", 0.2, Истина);

КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуСтроки()

	Строка = Элементы.Товары.ТекущиеДанные;
	Если Строка <> Неопределено Тогда
		Строка.Сумма = Строка.Количество * Строка.Цена;
	КонецЕсли;
	ОбновитьИтог();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИтог()

	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма");

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКарточку()

	Строка = Элементы.Товары.ТекущиеДанные;
	ОбновитьКарточкуНаСервере(?(Строка = Неопределено, Неопределено, Строка.Номенклатура));

КонецПроцедуры

&НаСервере
Процедура ОбновитьКарточкуНаСервере(Номенклатура)

	Бронь = Неопределено;
	Если РежимПодбора() = "Продажа" Тогда
		Бронь = Объект.Бронирование;
	ИначеЕсли РежимПодбора() = "Бронь" Тогда
		Бронь = Объект.Ссылка;
	КонецЕсли;
	Описание = РаботаСЦенами.ОписаниеТовара(Номенклатура, РежимПодбора(), Объект.Дата, Бронь);
	Элементы.ДекорацияТовар.Заголовок = Описание.Наименование;
	Элементы.ДекорацияЦенаТовара.Заголовок = Описание.ТекстЦены;
	Элементы.ДекорацияОстаток.Заголовок = Описание.ТекстОстатка;

	ДвоичныеДанные = Описание.Фото;
	Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
		ДвоичныеДанные = БиблиотекаКартинок.НетФото.ПолучитьДвоичныеДанные();
	КонецЕсли;
	Если ЭтоАдресВременногоХранилища(АдресФото) Тогда
		УдалитьИзВременногоХранилища(АдресФото);
	КонецЕсли;
	АдресФото = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЦенаТовара(Номенклатура, Режим, Дата)

	Возврат РаботаСЦенами.ЦенаДляДокумента(Номенклатура, Режим, Дата);

КонецФункции

&НаКлиенте
Процедура ПечатьНакладной(Команда)

	Если Объект.Ссылка.Пустая() Или Модифицированность Тогда
		Если Не Записать() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ТД = ПечатнаяФорма(Объект.Ссылка);
	ТД.Показать(ЗаголовокПечати() + Объект.Номер);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПечатнаяФорма(Ссылка)

	Возврат ПечатьДокументов.СформироватьНакладную(Ссылка);

КонецФункции

#КонецОбласти
