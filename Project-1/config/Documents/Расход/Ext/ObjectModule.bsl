
#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Организация) Тогда
		Выборка = Справочники.Организации.Выбрать();
		Если Выборка.Следующий() Тогда
			Организация = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;

	Если ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.Покупатели") Тогда
		Покупатель = ДанныеЗаполнения;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.Бронирование") Тогда
		// Продажа по брони: покупатель, товары и цены берутся из брони
		Бронирование = ДанныеЗаполнения;
		ЗаполнитьПоБрони();
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Для Каждого Стр Из Товары Цикл
		Стр.Сумма = Стр.Количество * Стр.Цена;
	КонецЦикла;
	СуммаДокумента = Товары.Итог("Сумма");

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)

	// Очищаем старые движения, чтобы они не влияли на проверку остатков при перепроведении
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.ОстаткиТоваров.Записать();
	Движения.ТоварыВРезерве.Записывать = Истина;
	Движения.ТоварыВРезерве.Записать();
	Движения.Продажи.Записывать = Истина;

	Если ЗначениеЗаполнено(Бронирование) Тогда
		Если Не Бронирование.Проведен Тогда
			СообщитьОбОшибке(НСтр("ru = 'Указанная бронь не проведена'; zh = '所选预订未过账'"), "Бронирование");
			Отказ = Истина;
			Возврат;
		ИначеЕсли Бронирование.Покупатель <> Покупатель Тогда
			СообщитьОбОшибке(СтрШаблон(НСтр("ru = 'Бронь оформлена на другого покупателя: %1'; zh = '该预订属于其他客户：%1'"), Бронирование.Покупатель), "Бронирование");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;

	// Блокируем остатки и резерв списываемых товаров
	Блокировка = Новый БлокировкаДанных;
	Для Каждого ИмяРегистра Из СтрРазделить("ОстаткиТоваров,ТоварыВРезерве", ",") Цикл
		ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления." + ИмяРегистра);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.ИсточникДанных = Товары;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
	КонецЦикла;
	Блокировка.Заблокировать();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТЧ.Номенклатура КАК Номенклатура,
	|	СУММА(ТЧ.Количество) КАК Количество,
	|	СУММА(ТЧ.Сумма) КАК Сумма
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	Документ.Расход.Товары КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ТЧ.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Номенклатура КАК Номенклатура,
	|	ПРЕДСТАВЛЕНИЕ(ВТ.Номенклатура) КАК НоменклатураПредставление,
	|	ВТ.Количество КАК Количество,
	|	ВТ.Сумма КАК Сумма,
	|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК ОстатокКоличество,
	|	ЕСТЬNULL(Остатки.СуммаОстаток, 0) КАК ОстатокСумма,
	|	ЕСТЬNULL(Резерв.Всего, 0) КАК ВРезерве,
	|	ЕСТЬNULL(Резерв.ПоБрони, 0) КАК ВРезервеПоБрони
	|ИЗ
	|	ВТ_Товары КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(
	|				&МоментВремени,
	|				Номенклатура В
	|					(ВЫБРАТЬ
	|						Т.Номенклатура
	|					ИЗ
	|						ВТ_Товары КАК Т)) КАК Остатки
	|		ПО ВТ.Номенклатура = Остатки.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Р.Номенклатура КАК Номенклатура,
	|			СУММА(Р.КоличествоОстаток) КАК Всего,
	|			СУММА(ВЫБОР
	|					КОГДА Р.Бронирование = &Бронирование
	|						ТОГДА Р.КоличествоОстаток
	|					ИНАЧЕ 0
	|				КОНЕЦ) КАК ПоБрони
	|		ИЗ
	|			РегистрНакопления.ТоварыВРезерве.Остатки(
	|					&МоментВремени,
	|					Номенклатура В
	|						(ВЫБРАТЬ
	|							Т.Номенклатура
	|						ИЗ
	|							ВТ_Товары КАК Т)) КАК Р
	|		СГРУППИРОВАТЬ ПО
	|			Р.Номенклатура) КАК Резерв
	|		ПО ВТ.Номенклатура = Резерв.Номенклатура";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Бронирование", Бронирование);
	Запрос.УстановитьПараметр("МоментВремени", Новый Граница(МоментВремени(), ВидГраницы.Исключая));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		// Продать можно свободный остаток и товар, забронированный по этой брони
		ЧужойРезерв = Выборка.ВРезерве - Выборка.ВРезервеПоБрони;
		Доступно = Выборка.ОстатокКоличество - ЧужойРезерв;
		Если Выборка.Количество > Доступно Тогда
			Если ЧужойРезерв > 0 Тогда
				Текст = СтрШаблон(НСтр("ru = 'Недостаточно свободного товара «%1»: требуется %2 шт., на складе %3 шт., из них забронировано за другими покупателями %4 шт. Можно продать: %5 шт.'; zh = '商品「%1」可售数量不足：需要 %2 件，库存 %3 件，其中 %4 件已被其他客户预订。可售：%5 件'"),
					Выборка.НоменклатураПредставление, Выборка.Количество, Выборка.ОстатокКоличество, ЧужойРезерв, Макс(Доступно, 0));
			Иначе
				Текст = СтрШаблон(НСтр("ru = 'Недостаточно товара «%1» на складе: требуется %2 шт., в наличии %3 шт.'; zh = '商品「%1」库存不足：需要 %2 件，现有 %3 件'"),
					Выборка.НоменклатураПредставление, Выборка.Количество, Выборка.ОстатокКоличество);
			КонецЕсли;
			СообщитьОбОшибке(Текст);
			Отказ = Истина;
			Продолжить;
		КонецЕсли;

		// Себестоимость списания по средней цене остатка
		Себестоимость = Окр(Выборка.ОстатокСумма * Выборка.Количество / Выборка.ОстатокКоличество, 2);

		Движение = Движения.ОстаткиТоваров.ДобавитьРасход();
		Движение.Период = Дата;
		Движение.Номенклатура = Выборка.Номенклатура;
		Движение.Количество = Выборка.Количество;
		Движение.Сумма = Себестоимость;

		Движение = Движения.Продажи.Добавить();
		Движение.Период = Дата;
		Движение.Номенклатура = Выборка.Номенклатура;
		Движение.Покупатель = Покупатель;
		Движение.Организация = Организация;
		Движение.Количество = Выборка.Количество;
		Движение.Сумма = Выборка.Сумма;
		Движение.Себестоимость = Себестоимость;

		// Проданный по брони товар снимается с резерва
		СнятьСРезерва = Мин(Выборка.Количество, Выборка.ВРезервеПоБрони);
		Если СнятьСРезерва > 0 Тогда
			Движение = Движения.ТоварыВРезерве.ДобавитьРасход();
			Движение.Период = Дата;
			Движение.Номенклатура = Выборка.Номенклатура;
			Движение.Бронирование = Бронирование;
			Движение.Количество = СнятьСРезерва;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет документ по брони: покупатель, организация и товары, оставшиеся в резерве (по ценам брони).
Процедура ЗаполнитьПоБрони() Экспорт

	Если Не ЗначениеЗаполнено(Бронирование) Тогда
		Возврат;
	КонецЕсли;
	Покупатель = Бронирование.Покупатель;
	Организация = Бронирование.Организация;
	Товары.Очистить();
	Для Каждого Стр Из РаботаСБронями.ТоварыВРезервеПоБрони(Бронирование) Цикл
		НоваяСтрока = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
		НоваяСтрока.Сумма = НоваяСтрока.Количество * НоваяСтрока.Цена;
	КонецЦикла;
	СуммаДокумента = Товары.Итог("Сумма");

КонецПроцедуры

Процедура СообщитьОбОшибке(Текст, Поле = "")

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Если Не ПустаяСтрока(Поле) Тогда
		Сообщение.Поле = Поле;
		Сообщение.УстановитьДанные(ЭтотОбъект);
	КонецЕсли;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти
