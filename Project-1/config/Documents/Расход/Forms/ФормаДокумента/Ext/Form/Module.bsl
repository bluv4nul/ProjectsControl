
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбновитьЗаголовок();
	ОбновитьПодсказкуБрони();
	ОбновитьКарточкуНаСервере(?(Объект.Товары.Количество() > 0, Объект.Товары[0].Номенклатура, Неопределено));

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	ОбновитьЗаголовок();
	ОбновитьПодсказкуБрони();

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	Оповестить("ВольтМаркет_ИзмененыОстатки");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПокупательПриИзменении(Элемент) Экспорт

	ОбновитьПодсказкуБрони();

КонецПроцедуры

&НаКлиенте
Процедура БронированиеПриИзменении(Элемент)

	Если Не ЗначениеЗаполнено(Объект.Бронирование) Тогда
		ОбновитьПодсказкуБрони();
		Возврат;
	КонецЕсли;
	Если Объект.Товары.Количество() = 0 Тогда
		ЗаполнитьПоБрониНаСервере(Объект.Бронирование);
		Возврат;
	КонецЕсли;
	ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьПоБрониЗавершение", ЭтотОбъект, Объект.Бронирование),
		НСтр("ru = 'Заменить товары в документе товарами из брони?'; zh = '是否用预订中的商品替换单据中的商品？'"), РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоБрониЗавершение(Ответ, Бронирование) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПоБрониНаСервере(Бронирование);
	Иначе
		ОбновитьПодсказкуБрони();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДекорацияБроньНажатие(Элемент) Экспорт

	Если ЗначениеЗаполнено(ПредлагаемаяБронь) Тогда
		Объект.Бронирование = ПредлагаемаяБронь;
		БронированиеПриИзменении(Элементы.Бронирование);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьЦены(Команда) Экспорт

	ЗаполнитьЦеныНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьПоБрониНаСервере(Бронирование)

	Документ = РеквизитФормыВЗначение("Объект");
	Документ.Бронирование = Бронирование;
	Документ.ЗаполнитьПоБрони();
	ЗначениеВРеквизитФормы(Документ, "Объект");
	Модифицированность = Истина;
	ОбновитьПодсказкуБрони();
	ОбновитьКарточкуНаСервере(?(Объект.Товары.Количество() > 0, Объект.Товары[0].Номенклатура, Неопределено));

КонецПроцедуры

// Если у покупателя есть активная бронь, показываем ссылку «Оформить продажу по брони».
&НаСервере
Процедура ОбновитьПодсказкуБрони()

	ПредлагаемаяБронь = Документы.Бронирование.ПустаяСсылка();
	Элементы.ДекорацияБронь.Видимость = Ложь;
	Если ЗначениеЗаполнено(Объект.Бронирование) Тогда
		Элементы.Бронирование.ЦветТекста = ЦветаСтиля.ЦветСиний;
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Покупатель) Или Объект.Проведен Тогда
		Возврат;
	КонецЕсли;

	Брони = РаботаСБронями.АктивныеБрони(Объект.Покупатель);
	Если Брони.Количество() = 0 Тогда
		Возврат;
	ИначеЕсли Брони.Количество() = 1 Тогда
		ПредлагаемаяБронь = Брони[0].Бронирование;
		Элементы.ДекорацияБронь.Заголовок = СтрШаблон(НСтр("ru = 'У покупателя есть бронь № %1 до %2 (%3 шт. в резерве) — нажмите, чтобы оформить продажу по брони'; zh = '该客户有预订 № %1，有效期至 %2（预订 %3 件）— 点击按预订办理销售'"),
			Брони[0].Номер, Формат(Брони[0].СрокБрони, "ДЛФ=D"), Брони[0].Количество);
	Иначе
		Элементы.ДекорацияБронь.Заголовок = СтрШаблон(НСтр("ru = 'У покупателя активных броней: %1 — выберите нужную в поле «Бронь»'; zh = '该客户有 %1 个有效预订 — 请在「预订」字段中选择'"),
			Брони.Количество());
	КонецЕсли;
	Элементы.ДекорацияБронь.Видимость = Истина;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЦеныНаСервере()

	Для Каждого Строка Из Объект.Товары Цикл
		Строка.Цена = РаботаСЦенами.ЦенаНоменклатуры(Строка.Номенклатура, Объект.Дата);
		Строка.Сумма = Строка.Количество * Строка.Цена;
	КонецЦикла;
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма");

КонецПроцедуры

&НаСервере
Процедура ОбновитьЗаголовок()

	Если Объект.Ссылка.Пустая() Тогда
		Элементы.ДекорацияЗаголовок.Заголовок = НСтр("ru = 'Новая продажа товаров'; zh = '新建商品销售'");
	Иначе
		Элементы.ДекорацияЗаголовок.Заголовок = СтрШаблон(НСтр("ru = 'Продажа товаров № %1 от %2'; zh = '商品销售 № %1，日期 %2'"),
			Объект.Номер, Формат(Объект.Дата, "ДЛФ=D"));
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.Бронирование) Тогда
		Элементы.ДекорацияПодзаголовок.Заголовок = СтрШаблон(НСтр("ru = 'Продажа по брони № %1: товар снимается с резерва покупателя'; zh = '按预订 № %1 销售：商品从客户预订中扣除'"),
			Объект.Бронирование.Номер);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ЗаголовокПечати()

	Возврат НСтр("ru = 'Расходная накладная № '; zh = '发货单 № '");

КонецФункции

#КонецОбласти

#Область ОбщиеПроцедурыФормДокументов
// Общие процедуры форм документов с табличной частью «Товары» (поступление, продажа, бронь):
// быстрый ввод по артикулу, подбор товаров, карточка текущего товара, пересчёт сумм.

&НаКлиентеНаСервереБезКонтекста
Функция РежимПодбора()

	Возврат "Продажа";

КонецФункции

&НаКлиенте
Процедура БыстрыйВводПриИзменении(Элемент) Экспорт

	Если ПустаяСтрока(БыстрыйВвод) Тогда
		Возврат;
	КонецЕсли;
	ИдентификаторСтроки = ДобавитьПоСтрокеПоиска(БыстрыйВвод);
	БыстрыйВвод = "";
	Если ИдентификаторСтроки <> Неопределено Тогда
		Элементы.Товары.ТекущаяСтрока = ИдентификаторСтроки;
		ОбновитьКарточку();
	КонецЕсли;
	ТекущийЭлемент = Элементы.БыстрыйВвод;

КонецПроцедуры

&НаСервере
Функция ДобавитьПоСтрокеПоиска(Текст)

	Найденные = РаботаСЦенами.НайтиТовары(Текст);
	Если Найденные.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон(НСтр("ru = 'Товар «%1» не найден. Проверьте артикул или откройте «Подбор товаров».'; zh = '未找到商品「%1」。请检查货号或打开「选择商品」。'"), Текст);
		Сообщение.Сообщить();
		Возврат Неопределено;
	ИначеЕсли Найденные.Количество() > 1 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон(НСтр("ru = 'По запросу «%1» найдено товаров: %2. Уточните запрос (лучше ввести артикул) или откройте «Подбор товаров».'; zh = '按「%1」找到 %2 个商品。请输入更准确的内容（最好是货号）或打开「选择商品」。'"),
			Текст, Найденные.Количество());
		Сообщение.Сообщить();
		Возврат Неопределено;
	КонецЕсли;
	Возврат ДобавитьТовар(Найденные[0], 1);

КонецФункции

// Добавляет товар в табличную часть; если товар уже есть - увеличивает количество. Возвращает идентификатор строки.
&НаСервере
Функция ДобавитьТовар(Номенклатура, Количество, Цена = Неопределено)

	Строки = Объект.Товары.НайтиСтроки(Новый Структура("Номенклатура", Номенклатура));
	Если Строки.Количество() > 0 Тогда
		Строка = Строки[0];
	Иначе
		Строка = Объект.Товары.Добавить();
		Строка.Номенклатура = Номенклатура;
		Строка.Цена = ?(Цена = Неопределено, РаботаСЦенами.ЦенаДляДокумента(Номенклатура, РежимПодбора(), Объект.Дата), Цена);
	КонецЕсли;
	Строка.Количество = Строка.Количество + Количество;
	Строка.Сумма = Строка.Количество * Строка.Цена;
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма");
	Модифицированность = Истина;
	Возврат Строка.ПолучитьИдентификатор();

КонецФункции

&НаКлиенте
Процедура Подбор(Команда) Экспорт

	Параметры = Новый Структура("Режим, Дата", РежимПодбора(), Объект.Дата);
	Если РежимПодбора() = "Продажа" Тогда
		Параметры.Вставить("Бронирование", Объект.Бронирование);
	ИначеЕсли РежимПодбора() = "Бронь" И ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Параметры.Вставить("Бронирование", Объект.Ссылка);
	КонецЕсли;
	ОткрытьФорму("ОбщаяФорма.ПодборТоваров", Параметры, ЭтаФорма, , , ,
		Новый ОписаниеОповещения("ПодборЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ПодборЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(Результат) <> Тип("Массив") Или Результат.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ИдентификаторСтроки = ПеренестиПодбор(Результат);
	Если ИдентификаторСтроки <> Неопределено Тогда
		Элементы.Товары.ТекущаяСтрока = ИдентификаторСтроки;
		ОбновитьКарточку();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПеренестиПодбор(Выбранные)

	ИдентификаторСтроки = Неопределено;
	Для Каждого Выбранный Из Выбранные Цикл
		ИдентификаторСтроки = ДобавитьТовар(Выбранный.Номенклатура, Выбранный.Количество, Выбранный.Цена);
	КонецЦикла;
	Возврат ИдентификаторСтроки;

КонецФункции

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)

	Строка = Элементы.Товары.ТекущиеДанные;
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Строка.Цена = ЦенаТовара(Строка.Номенклатура, РежимПодбора(), Объект.Дата);
	Если Строка.Количество = 0 Тогда
		Строка.Количество = 1;
	КонецЕсли;
	РассчитатьСуммуСтроки();
	ОбновитьКарточку();

КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)

	РассчитатьСуммуСтроки();

КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)

	РассчитатьСуммуСтроки();

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПослеУдаления(Элемент)

	ОбновитьИтог();

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ОбновитьКарточку", 0.2, Истина);

КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуСтроки()

	Строка = Элементы.Товары.ТекущиеДанные;
	Если Строка <> Неопределено Тогда
		Строка.Сумма = Строка.Количество * Строка.Цена;
	КонецЕсли;
	ОбновитьИтог();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИтог()

	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма");

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКарточку()

	Строка = Элементы.Товары.ТекущиеДанные;
	ОбновитьКарточкуНаСервере(?(Строка = Неопределено, Неопределено, Строка.Номенклатура));

КонецПроцедуры

&НаСервере
Процедура ОбновитьКарточкуНаСервере(Номенклатура)

	Бронь = Неопределено;
	Если РежимПодбора() = "Продажа" Тогда
		Бронь = Объект.Бронирование;
	ИначеЕсли РежимПодбора() = "Бронь" Тогда
		Бронь = Объект.Ссылка;
	КонецЕсли;
	Описание = РаботаСЦенами.ОписаниеТовара(Номенклатура, РежимПодбора(), Объект.Дата, Бронь);
	Элементы.ДекорацияТовар.Заголовок = Описание.Наименование;
	Элементы.ДекорацияЦенаТовара.Заголовок = Описание.ТекстЦены;
	Элементы.ДекорацияОстаток.Заголовок = Описание.ТекстОстатка;

	ДвоичныеДанные = Описание.Фото;
	Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
		ДвоичныеДанные = БиблиотекаКартинок.НетФото.ПолучитьДвоичныеДанные();
	КонецЕсли;
	Если ЭтоАдресВременногоХранилища(АдресФото) Тогда
		УдалитьИзВременногоХранилища(АдресФото);
	КонецЕсли;
	АдресФото = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЦенаТовара(Номенклатура, Режим, Дата)

	Возврат РаботаСЦенами.ЦенаДляДокумента(Номенклатура, Режим, Дата);

КонецФункции

&НаКлиенте
Процедура ПечатьНакладной(Команда)

	Если Объект.Ссылка.Пустая() Или Модифицированность Тогда
		Если Не Записать() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ТД = ПечатнаяФорма(Объект.Ссылка);
	ТД.Показать(ЗаголовокПечати() + Объект.Номер);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПечатнаяФорма(Ссылка)

	Возврат ПечатьДокументов.СформироватьНакладную(Ссылка);

КонецФункции

#КонецОбласти
