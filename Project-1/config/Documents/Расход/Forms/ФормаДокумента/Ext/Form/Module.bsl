
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбновитьЗаголовок();

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	ОбновитьЗаголовок();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)

	Строка = Элементы.Товары.ТекущиеДанные;
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Строка.Цена = ЦенаТовара(Строка.Номенклатура, Объект.Дата);
	Если Строка.Количество = 0 Тогда
		Строка.Количество = 1;
	КонецЕсли;
	РассчитатьСуммуСтроки();
	ПоказатьОстаток();

КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)

	РассчитатьСуммуСтроки();

КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)

	РассчитатьСуммуСтроки();

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПослеУдаления(Элемент)

	ОбновитьИтог();

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ПоказатьОстаток", 0.2, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПечатьНакладной(Команда)

	Если Объект.Ссылка.Пустая() Или Модифицированность Тогда
		Если Не Записать() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ТД = ПечатнаяФорма(Объект.Ссылка);
	ТД.Показать(НСтр("ru = 'Расходная накладная № '; zh = '发货单 № '") + Объект.Номер);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЦены(Команда)

	ЗаполнитьЦеныНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСуммуСтроки()

	Строка = Элементы.Товары.ТекущиеДанные;
	Если Строка <> Неопределено Тогда
		Строка.Сумма = Строка.Количество * Строка.Цена;
	КонецЕсли;
	ОбновитьИтог();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИтог()

	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма");

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОстаток()

	Строка = Элементы.Товары.ТекущиеДанные;
	Если Строка = Неопределено Или Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
		Элементы.ДекорацияОстаток.Заголовок = НСтр("ru = 'Выберите товар, чтобы увидеть остаток на складе'; zh = '选择商品以查看库存'");
		Возврат;
	КонецЕсли;

	Остаток = ОстатокТовара(Строка.Номенклатура);
	Элементы.ДекорацияОстаток.Заголовок = СтрШаблон(НСтр("ru = 'На складе: %1 шт. — %2'; zh = '库存：%1 件 — %2'"), Остаток, Строка.Номенклатура);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЦеныНаСервере()

	Для Каждого Строка Из Объект.Товары Цикл
		Строка.Цена = РаботаСЦенами.ЦенаНоменклатуры(Строка.Номенклатура, Объект.Дата);
		Строка.Сумма = Строка.Количество * Строка.Цена;
	КонецЦикла;
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма");

КонецПроцедуры

&НаСервере
Процедура ОбновитьЗаголовок()

	Если Объект.Ссылка.Пустая() Тогда
		Элементы.ДекорацияЗаголовок.Заголовок = НСтр("ru = 'Новая продажа товаров'; zh = '新建商品销售'");
	Иначе
		Элементы.ДекорацияЗаголовок.Заголовок = СтрШаблон(НСтр("ru = 'Продажа товаров № %1 от %2'; zh = '商品销售 № %1，日期 %2'"),
			Объект.Номер, Формат(Объект.Дата, "ДЛФ=D"));
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЦенаТовара(Номенклатура, Дата)

	Возврат РаботаСЦенами.ЦенаНоменклатуры(Номенклатура, Дата);

КонецФункции

&НаСервереБезКонтекста
Функция ОстатокТовара(Номенклатура)

	Возврат РаботаСЦенами.ОстатокНоменклатуры(Номенклатура);

КонецФункции

&НаСервереБезКонтекста
Функция ПечатнаяФорма(Ссылка)

	Возврат ПечатьДокументов.СформироватьНакладную(Ссылка);

КонецФункции

#КонецОбласти
