
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	НастроитьОформление();
	Если Элементы.Найти("СписокСостояние") <> Неопределено Тогда
		НастроитьСписокБроней();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура НастроитьОформление()

	// Сумма документа - фирменным синим жирным
	Если Элементы.Найти("СписокСуммаДокумента") <> Неопределено Тогда
		Элемент = УсловноеОформление.Элементы.Добавить();
		Поле = Элемент.Поля.Элементы.Добавить();
		Поле.Поле = Новый ПолеКомпоновкиДанных(Элементы.СписокСуммаДокумента.Имя);
		Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветСиний);
		Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтыСтиля.ШрифтЖирный);
	КонецЕсли;

	// Непроведённые документы - серым
	Элемент = Список.УсловноеОформление.Элементы.Добавить();
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Проведен");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Ложь;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНеПроведен);
	Элемент.Представление = НСтр("ru = 'Непроведённые документы'; zh = '未过账单据'");

КонецПроцедуры

// Список броней: параметры запроса и цвет состояния (активна - синим, срок истёк - красным, закрытые - серым).
&НаСервере
Процедура НастроитьСписокБроней()

	Список.Параметры.УстановитьЗначениеПараметра("ТекущаяДата", НачалоДня(ТекущаяДатаСеанса()));
	Для Код = 0 По 6 Цикл
		Список.Параметры.УстановитьЗначениеПараметра("Состояние" + Код, РаботаСБронями.ПредставлениеСостояния(Код));
	КонецЦикла;

	Цвета = Новый Соответствие;
	Цвета.Вставить(1, ЦветаСтиля.ЦветСиний);
	Цвета.Вставить(6, ЦветаСтиля.ЦветСиний);
	Цвета.Вставить(2, Новый Цвет(198, 40, 40));
	Цвета.Вставить(3, ЦветаСтиля.ЦветНеПроведен);
	Цвета.Вставить(4, ЦветаСтиля.ЦветНеПроведен);
	Цвета.Вставить(5, ЦветаСтиля.ЦветНеПроведен);
	Для Каждого КодИЦвет Из Цвета Цикл
		Элемент = Список.УсловноеОформление.Элементы.Добавить();
		Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("КодСостояния");
		Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Отбор.ПравоеЗначение = КодИЦвет.Ключ;
		Поле = Элемент.Поля.Элементы.Добавить();
		Поле.Поле = Новый ПолеКомпоновкиДанных("Состояние");
		Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", КодИЦвет.Значение);
		Если КодИЦвет.Ключ = 1 Или КодИЦвет.Ключ = 2 Или КодИЦвет.Ключ = 6 Тогда
			Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтыСтиля.ШрифтЖирный);
		КонецЕсли;
	КонецЦикла;

	// Просроченные брони: срок - красным
	Элемент = Список.УсловноеОформление.Элементы.Добавить();
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("КодСостояния");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = 2;
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("СрокБрони");
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(198, 40, 40));

КонецПроцедуры

#КонецОбласти
