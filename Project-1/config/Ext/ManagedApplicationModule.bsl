
Процедура ПриНачалеРаботыСистемы()

	// В новой (пустой) базе при первом запуске загружаем демонстрационные данные
	Если ДемоДанные.НужноЗаполнить() Тогда
		ДемоДанные.Заполнить();
		ПоказатьОповещениеПользователя("ВольтМаркет", , НСтр("ru = 'Загружены демонстрационные данные'; zh = '已加载演示数据'"), БиблиотекаКартинок.РазделСправочники);
	КонецЕсли;

	// Служебный режим: используется при сборке базы из командной строки
	Если СтрНайти(ПараметрЗапуска, "ЗавершитьРаботу") > 0 Тогда
		ЗавершитьРаботуСистемы(Ложь);
	КонецЕсли;

КонецПроцедуры
