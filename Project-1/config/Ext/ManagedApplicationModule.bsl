
Процедура ПриНачалеРаботыСистемы()

	// Служебный режим: используется при сборке базы из командной строки (/C"ЗаполнитьДемоДанные").
	// Демонстрационные данные загружаются только по этой явной команде и только в полностью пустую базу.
	Если СтрНайти(ПараметрЗапуска, "ЗаполнитьДемоДанные") > 0 Тогда
		ДемоДанные.Заполнить();
		ЗавершитьРаботуСистемы(Ложь);
	КонецЕсли;

КонецПроцедуры
