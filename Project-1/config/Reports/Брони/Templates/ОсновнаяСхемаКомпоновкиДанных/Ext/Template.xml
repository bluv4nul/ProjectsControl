		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Р.Бронирование КАК Бронирование,
	Р.Бронирование.Покупатель КАК Покупатель,
	Р.Бронирование.СрокБрони КАК СрокБрони,
	Р.Номенклатура КАК Номенклатура,
	СУММА(ВЫБОР
		КОГДА Р.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
			ТОГДА Р.Количество
		ИНАЧЕ 0
	КОНЕЦ) КАК Забронировано,
	СУММА(ВЫБОР
		КОГДА Р.Регистратор ССЫЛКА Документ.Расход
			ТОГДА Р.Количество
		ИНАЧЕ 0
	КОНЕЦ) КАК Выкуплено,
	СУММА(ВЫБОР
		КОГДА Р.Регистратор ССЫЛКА Документ.ОтменаБронирования
			ТОГДА Р.Количество
		ИНАЧЕ 0
	КОНЕЦ) КАК Отменено,
	СУММА(ВЫБОР
		КОГДА Р.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
			ТОГДА Р.Количество
		ИНАЧЕ -Р.Количество
	КОНЕЦ) КАК ВРезерве
ИЗ
	РегистрНакопления.ТоварыВРезерве КАК Р
ГДЕ
	Р.Активность
СГРУППИРОВАТЬ ПО
	Р.Бронирование,
	Р.Бронирование.Покупатель,
	Р.Бронирование.СрокБрони,
	Р.Номенклатура</query>
