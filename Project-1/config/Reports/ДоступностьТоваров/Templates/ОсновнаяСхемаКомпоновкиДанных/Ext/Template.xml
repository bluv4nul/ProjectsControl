		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Остатки.Номенклатура КАК Номенклатура,
	Остатки.Номенклатура.Родитель КАК Группа,
	Остатки.КоличествоОстаток КАК Остаток,
	ЕСТЬNULL(Резерв.Количество, 0) КАК Забронировано,
	Остатки.КоличествоОстаток - ЕСТЬNULL(Резерв.Количество, 0) КАК Доступно
ИЗ
	РегистрНакопления.ОстаткиТоваров.Остатки(, ) КАК Остатки
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			Р.Номенклатура КАК Номенклатура,
			СУММА(Р.КоличествоОстаток) КАК Количество
		ИЗ
			РегистрНакопления.ТоварыВРезерве.Остатки(, ) КАК Р
		СГРУППИРОВАТЬ ПО
			Р.Номенклатура) КАК Резерв
		ПО Остатки.Номенклатура = Резерв.Номенклатура</query>
