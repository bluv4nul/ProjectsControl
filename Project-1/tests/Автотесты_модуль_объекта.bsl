
// Контрольный пример ВольтМаркета: сценарии Б01–Б19 (бронирование), Р01–Р14 (учёт и права), П01–П02 (подбор),
// А01–А06 (автоснятие броней и отчёт). Запускать на демонстрационной базе VoltMarket.dt под пользователем
// «Администратор»: тесты опираются на демонстрационные товары, брони и покупателей.

Функция ВыполнитьАвтотесты() Экспорт

	Если Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", "VM-SP-003").Пустая() Тогда
		Возврат НСтр("ru = 'Контрольный пример рассчитан на демонстрационную базу VoltMarket.dt: товар VM-SP-003 не найден, проверки не запускались.'");
	КонецЕсли;
	ОтладкаАвтотесты();
	Документ = Новый ТекстовыйДокумент;
	Документ.Прочитать(КаталогВременныхФайлов() + "vm_autotests_" + ИмяПользователя() + ".txt", КодировкаТекста.UTF8);
	Текст = Документ.ПолучитьТекст();
	Пройдено = СтрЧислоВхождений(Текст, Символы.Таб + "PASS" + Символы.Таб);
	НеПройдено = СтрЧислоВхождений(Текст, Символы.Таб + "FAIL" + Символы.Таб);
	Возврат СтрШаблон("Пройдено: %1, не пройдено: %2", Пройдено, НеПройдено) + Символы.ПС + Текст;

КонецФункции

Функция ОтладкаСсылка(Вид) Экспорт
	Если Вид = "Номенклатура" Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Н.Ссылка ИЗ Справочник.Номенклатура КАК Н ГДЕ Н.Артикул = ""VM-SP-001""");
	Иначе
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка ИЗ Документ." + Вид + " КАК Д УПОРЯДОЧИТЬ ПО Д.Дата УБЫВ");
		Если Вид = "Расход" Тогда
			Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка ИЗ Документ.Расход КАК Д ГДЕ Д.Проведен УПОРЯДОЧИТЬ ПО Д.Дата УБЫВ";
		КонецЕсли;
	КонецЕсли;
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Ссылка;
КонецФункции

Функция ОтладкаДокумент(Вид, Номер) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка ИЗ Документ." + Вид + " КАК Д ГДЕ Д.Номер = &Номер");
	Запрос.УстановитьПараметр("Номер", Прав("000000000" + Номер, 9));
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);
КонецФункции

Функция ОтладкаЭлемент(Справочник, Фрагмент) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 С.Ссылка ИЗ Справочник." + Справочник + " КАК С ГДЕ С.Наименование ПОДОБНО &Ш");
	Запрос.УстановитьПараметр("Ш", "%" + Фрагмент + "%");
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);
КонецФункции

Функция ОтладкаТовар(Артикул) Экспорт
	Возврат Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Артикул);
КонецФункции

Функция ОтладкаПечать(Вид = "Расход", Номер = "") Экспорт
	Ссылка = ?(ПустаяСтрока(Номер), ОтладкаСсылка(Вид), ОтладкаДокумент(Вид, Номер));
	Возврат ПечатьДокументов.СформироватьНакладную(Ссылка);
КонецФункции

// Проводит документ из сценария: возвращает тексты сообщений
Функция ОтладкаПровести(Ссылка, Режим = "Проведение") Экспорт
	Объект = Ссылка.ПолучитьОбъект();
	Попытка
		Объект.Записать(?(Режим = "Проведение", РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.ОтменаПроведения));
	Исключение
	КонецПопытки;
	Возврат "";
КонецФункции

Функция ОтладкаАвтоснятие() Экспорт
	Возврат РаботаСБронями.СнятьПросроченныеБрони().Снято;
КонецФункции

Функция ОтладкаРасписание() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Возврат РегламентныеЗадания.НайтиПредопределенное(Метаданные.РегламентныеЗадания.СнятиеПросроченныхБроней).Расписание;
КонецФункции

Процедура ОтладкаТест() Экспорт
	Ном = ОтладкаСсылка("Номенклатура");
	Для Каждого Вариант Из СтрРазделить("1,99999", ",") Цикл
		Попытка
			Если РольДоступна("Покупка") Тогда
				Д = Документы.Приход.СоздатьДокумент();
				Выб = Справочники.Поставщики.Выбрать(); Выб.Следующий(); Д.Поставщик = Выб.Ссылка;
			Иначе
				Д = Документы.Расход.СоздатьДокумент();
				Выб = Справочники.Покупатели.Выбрать(); Выб.Следующий(); Д.Покупатель = Выб.Ссылка;
			КонецЕсли;
			Д.Заполнить(Неопределено);
			Д.Дата = ТекущаяДатаСеанса();
			С = Д.Товары.Добавить(); С.Номенклатура = Ном; С.Количество = Число(Вариант); С.Цена = 100;
			Д.Записать(РежимЗаписиДокумента.Проведение);
			Итог = "ПРОВЕДЕН";
		Исключение
			Итог = "ОТКАЗ: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		ЗаписьЖурналаРегистрации("ВМТест", УровеньЖурналаРегистрации.Информация, , , ИмяПользователя() + " кол-во " + Вариант + ": " + Итог);
	КонецЦикла;
КонецПроцедуры

// ============================================================ Автотесты (каждый тест - в отменяемой транзакции)

Функция ТестТовар(Артикул)
	Возврат Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Артикул);
КонецФункции

Функция ТестОстатки(Артикул)
	Возврат РаботаСЦенами.ОстаткиТовара(ТестТовар(Артикул));
КонецФункции

Функция ТестТекстОстатков(Артикул)
	О = ТестОстатки(Артикул);
	Возврат СтрШаблон("%1: на складе %2, в резерве %3, свободно %4", Артикул, О.НаСкладе, О.ВРезерве, О.Свободно);
КонецФункции

Функция ТестНовыйДокумент(Вид, Покупатель, Строки)
	Д = Документы[Вид].СоздатьДокумент();
	Д.Заполнить(Неопределено);
	Д.Дата = ТекущаяДатаСеанса();
	Если Вид = "Приход" Тогда
		Д.Поставщик = ОтладкаЭлемент("Поставщики", Покупатель);
	ИначеЕсли Вид <> "ОтменаБронирования" Тогда
		Д.Покупатель = ОтладкаЭлемент("Покупатели", Покупатель);
	КонецЕсли;
	Для Каждого ОписаниеСтроки Из СтрРазделить(Строки, ";", Ложь) Цикл
		Части = СтрРазделить(ОписаниеСтроки, ":");
		С = Д.Товары.Добавить();
		С.Номенклатура = ТестТовар(Части[0]);
		С.Количество = Число(Части[1]);
		Если Вид <> "ОтменаБронирования" Тогда
			С.Цена = РаботаСЦенами.ЦенаДляДокумента(С.Номенклатура, ?(Вид = "Приход", "Закупка", "Продажа"));
		КонецЕсли;
	КонецЦикла;
	Возврат Д;
КонецФункции

// Записывает документ; возвращает "ПРОВЕДЁН" или "ОТКАЗ: <сообщения>"
Функция ТестЗаписать(Д, Режим = Неопределено)
	ПолучитьСообщенияПользователю(Истина);
	Попытка
		// как в форме: перед проведением проверяется заполнение реквизитов
		Если Режим = Неопределено И Не Д.ПроверитьЗаполнение() Тогда
			ВызватьИсключение "Проверка заполнения";
		КонецЕсли;
		Д.Записать(?(Режим = Неопределено, РежимЗаписиДокумента.Проведение, Режим));
		Итог = "ПРОВЕДЁН";
	Исключение
		Итог = "ОТКАЗ";
		Тексты = Новый Массив;
		Для Каждого С Из ПолучитьСообщенияПользователю(Истина) Цикл
			Тексты.Добавить(С.Текст);
		КонецЦикла;
		Если Тексты.Количество() = 0 Тогда
			Тексты.Добавить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецЕсли;
		Итог = Итог + ": " + СтрСоединить(Тексты, " | ");
	КонецПопытки;
	Возврат Итог;
КонецФункции

Процедура ТестЗапись(Лог, Код, Успех, Подробно)
	Лог.Добавить(Код + Символы.Таб + ?(Успех, "PASS", "FAIL") + Символы.Таб + Подробно);
КонецПроцедуры

Процедура ОтладкаАвтотесты() Экспорт

	Лог = Новый Массив;
	Лог.Добавить("Пользователь: " + ИмяПользователя() + "; дата: " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DT"));
	// на время тестов отключаем регламентное задание, чтобы оно не сняло брони посреди проверки
	УстановитьПривилегированныйРежим(Истина);
	Задание = РегламентныеЗадания.НайтиПредопределенное(Метаданные.РегламентныеЗадания.СнятиеПросроченныхБроней);
	БылоВключено = Задание.Использование;
	Задание.Использование = Ложь;
	Задание.Записать();
	УстановитьПривилегированныйРежим(Ложь);
	Тесты = СтрРазделить("Б01,Б02,Б03,Б04,Б05,Б06,Б07,Б08,Б09,Б10,Б11,Б12,Б13,Б14,Б15,Б16,Б17,Б18,Б19,Б20,Б21,Б22,Р01,Р02,Р03,Р04,Р05,Р06,Р07,Р08,Р09,Р10,Р11,Р12,Р13,Р14,Р15,Р16,П01,П02,А01,А02,А03,А04,А05,А06,А07", ",");
	Для Каждого Код Из Тесты Цикл
		Попытка
			ВыполнитьТест(Код, Лог);
		Исключение
			ТестЗапись(Лог, Код, Ложь, "ИСКЛЮЧЕНИЕ: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		УдалитьТестовыеДокументы();
	КонецЦикла;
	УстановитьПривилегированныйРежим(Истина);
	Задание.Использование = БылоВключено;
	Задание.Записать();
	УстановитьПривилегированныйРежим(Ложь);

	Текст = Новый ТекстовыйДокумент;
	Для Каждого Строка Из Лог Цикл
		Текст.ДобавитьСтроку(Строка);
	КонецЦикла;
	Текст.Записать(КаталогВременныхФайлов() + "vm_autotests_" + ИмяПользователя() + ".txt", КодировкаТекста.UTF8);

КонецПроцедуры

// Каждый тест создаёт документы текущей датой; после теста они удаляются, демо-данные (не позже 22.10.2026) не меняются
Процедура УдалитьТестовыеДокументы()
	УстановитьПривилегированныйРежим(Истина);
	Для Каждого Вид Из СтрРазделить("Расход,ОтменаБронирования,Приход,Бронирование", ",") Цикл
		Запрос = Новый Запрос("ВЫБРАТЬ Д.Ссылка ИЗ Документ." + Вид + " КАК Д ГДЕ Д.Дата >= &Начало");
		Запрос.УстановитьПараметр("Начало", НачалоДня(ТекущаяДатаСеанса()));
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Выборка.Ссылка.ПолучитьОбъект().Удалить();
		КонецЦикла;
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

Процедура ВыполнитьТест(Код, Лог)

	Если Код = "Б01" Тогда // бронь в пределах свободного остатка
		До = ТестОстатки("VM-SP-003");
		Д = ТестНовыйДокумент("Бронирование", "Соколов", "VM-SP-003:2");
		Итог = ТестЗаписать(Д);
		После = ТестОстатки("VM-SP-003");
		ТестЗапись(Лог, Код, Итог = "ПРОВЕДЁН" И После.ВРезерве = До.ВРезерве + 2 И После.Свободно = До.Свободно - 2 И После.НаСкладе = До.НаСкладе,
			СтрШаблон("%1; до: склад %2/резерв %3/свободно %4; после: склад %5/резерв %6/свободно %7", Итог, До.НаСкладе, До.ВРезерве, До.Свободно, После.НаСкладе, После.ВРезерве, После.Свободно));

	ИначеЕсли Код = "Б02" Тогда // бронь сверх свободного остатка
		До = ТестОстатки("VM-NB-003");
		Д = ТестНовыйДокумент("Бронирование", "Лидер", "VM-NB-003:2");
		Итог = ТестЗаписать(Д);
		ТестЗапись(Лог, Код, СтрНачинаетсяС(Итог, "ОТКАЗ") И СтрНайти(Итог, "свободно 1") > 0,
			ТестТекстОстатков("VM-NB-003") + "; " + Итог);

	ИначеЕсли Код = "Б03" Тогда // продажа сверх свободного: часть товара забронирована другим покупателем
		Д = ТестНовыйДокумент("Расход", "Лидер", "VM-NB-002:4");
		Итог = ТестЗаписать(Д);
		Д2 = ТестНовыйДокумент("Расход", "Лидер", "VM-NB-002:3");
		Итог2 = ТестЗаписать(Д2);
		ТестЗапись(Лог, Код, СтрНачинаетсяС(Итог, "ОТКАЗ") И СтрНайти(Итог, "другими покупателями 2") > 0 И Итог2 = "ПРОВЕДЁН",
			"4 шт.: " + Итог + "; 3 шт.: " + Итог2 + "; после: " + ТестТекстОстатков("VM-NB-002"));

	ИначеЕсли Код = "Б04" Тогда // продажа по брони целиком
		Бронь = ОтладкаДокумент("Бронирование", "2");
		СрокБыл = ТестПродлить(Бронь);
		До = ТестОстатки("VM-NB-002");
		Д = Документы.Расход.СоздатьДокумент();
		Д.Дата = ТекущаяДатаСеанса();
		Д.Заполнить(Бронь);
		Строк = Д.Товары.Количество();
		Итог = ТестЗаписать(Д);
		После = ТестОстатки("VM-NB-002");
		С = РаботаСБронями.СостояниеБрони(Бронь);
		ТестЗапись(Лог, Код, Итог = "ПРОВЕДЁН" И Строк = 2 И С.Код = 3 И После.НаСкладе = До.НаСкладе - 2 И После.Свободно = До.Свободно,
			СтрШаблон("%1; строк из брони: %2; покупатель: %3; NB-002 склад %4→%5, резерв %6→%7, свободно %8→%9; состояние: %10",
				Итог, Строк, Д.Покупатель, До.НаСкладе, После.НаСкладе, До.ВРезерве, После.ВРезерве, До.Свободно, После.Свободно, С.Представление));

		ТестВернутьСрок(Бронь, СрокБыл);

	ИначеЕсли Код = "Б05" Тогда // частичный выкуп брони
		Бронь = ОтладкаДокумент("Бронирование", "2");
		СрокБыл = ТестПродлить(Бронь);
		Д = Документы.Расход.СоздатьДокумент();
		Д.Дата = ТекущаяДатаСеанса();
		Д.Заполнить(Бронь);
		Д.Товары.Удалить(1);
		Итог = ТестЗаписать(Д);
		С = РаботаСБронями.СостояниеБрони(Бронь);
		ТестЗапись(Лог, Код, Итог = "ПРОВЕДЁН" И С.Код = 6 И С.ВРезерве = 2,
			СтрШаблон("%1; состояние: %2; выкуплено %3, в резерве %4; %5", Итог, С.Представление, С.Выкуплено, С.ВРезерве, ТестТекстОстатков("VM-AC-001")));

		ТестВернутьСрок(Бронь, СрокБыл);

	ИначеЕсли Код = "Б06" Тогда // отмена брони возвращает товар в свободный остаток
		Бронь = ОтладкаДокумент("Бронирование", "2");
		До = ТестОстатки("VM-NB-002");
		Д = Документы.ОтменаБронирования.СоздатьДокумент();
		Д.Дата = ТекущаяДатаСеанса();
		Д.Заполнить(Бронь);
		Д.Причина = "Покупатель передумал";
		Итог = ТестЗаписать(Д);
		После = ТестОстатки("VM-NB-002");
		С = РаботаСБронями.СостояниеБрони(Бронь);
		ТестЗапись(Лог, Код, Итог = "ПРОВЕДЁН" И С.Код = 4 И После.Свободно = До.Свободно + 2 И После.НаСкладе = До.НаСкладе,
			СтрШаблон("%1; строк: %2; NB-002 свободно %3→%4, склад %5→%6; состояние: %7", Итог, Д.Товары.Количество(), До.Свободно, После.Свободно, До.НаСкладе, После.НаСкладе, С.Представление));

	ИначеЕсли Код = "Б07" Тогда // снять с брони больше, чем в резерве
		Д = Документы.ОтменаБронирования.СоздатьДокумент();
		Д.Дата = ТекущаяДатаСеанса();
		Д.Заполнить(ОтладкаДокумент("Бронирование", "5"));
		Д.Товары[0].Количество = 2;
		Итог = ТестЗаписать(Д);
		ТестЗапись(Лог, Код, СтрНачинаетсяС(Итог, "ОТКАЗ") И СтрНайти(Итог, "только 1") > 0, Итог);

	ИначеЕсли Код = "Б08" Тогда // бронь с продажей нельзя распровести и перепровести
		Бронь1 = ОтладкаДокумент("Бронирование", "1").ПолучитьОбъект();
		Итог = ТестЗаписать(Бронь1, РежимЗаписиДокумента.ОтменаПроведения);
		Бронь6 = ОтладкаДокумент("Бронирование", "6").ПолучитьОбъект();
		Итог2 = ТестЗаписать(Бронь6);
