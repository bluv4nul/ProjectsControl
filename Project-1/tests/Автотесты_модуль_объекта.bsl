		Итог2 = ТестЗаписать(Продажа);
		Итог3 = ТестЗаписать(Отмена, РежимЗаписиДокумента.ОтменаПроведения);
		ТестЗапись(Лог, Код, Итог = "ПРОВЕДЁН" И Итог2 = "ПРОВЕДЁН" И СтрНачинаетсяС(Итог3, "ОТКАЗ") И СтрНайти(Итог3, "Не хватит") > 0,
			СтрШаблон("отмена брони: %1; продажа всех свободных %2 шт.: %3; отмена проведения «Отмены брони»: %4", Итог, Свободно, Итог2, Итог3));

	ИначеЕсли Код = "Р12" Тогда // нельзя продать по нулевой цене
		Д = ТестНовыйДокумент("Расход", "Соколов", "VM-SP-003:1");
		Д.Товары[0].Цена = 0;
		Итог = ТестЗаписать(Д);
		ТестЗапись(Лог, Код, СтрНачинаетсяС(Итог, "ОТКАЗ") И СтрНайти(Итог, "Цена") > 0, Итог);

	ИначеЕсли Код = "Р13" Тогда // продажа будущей датой учитывается при продаже сегодня
		О = ТестОстатки("VM-SP-003");
		Завтра = ТестНовыйДокумент("Расход", "Соколов", "VM-SP-003:" + Формат(О.Свободно, "ЧГ=0"));
		Завтра.Дата = ТекущаяДатаСеанса() + 86400;
		Итог = ТестЗаписать(Завтра);
		Сегодня = ТестНовыйДокумент("Расход", "Соколов", "VM-SP-003:1");
		Итог2 = ТестЗаписать(Сегодня);
		ТестЗапись(Лог, Код, Итог = "ПРОВЕДЁН" И СтрНачинаетсяС(Итог2, "ОТКАЗ") И СтрНайти(Итог2, "Не хватит") > 0,
			СтрШаблон("продажа всех свободных %1 шт. завтрашней датой: %2; ещё 1 шт. сегодня: %3", О.Свободно, Итог, Итог2));

	ИначеЕсли Код = "Р14" Тогда // нельзя отменить или уменьшить приход уже проданного товара
		Приход = ТестНовыйДокумент("Приход", "ТехноДистрибуция", "VM-SP-003:5");
		Приход.Дата = ТекущаяДатаСеанса() - 120;
		Итог = ТестЗаписать(Приход);
		Шаг1 = ТестТекстОстатков("VM-SP-003");
		Продажа = ТестНовыйДокумент("Расход", "Соколов", "VM-SP-003:" + Формат(ТестОстатки("VM-SP-003").Свободно, "ЧГ=0"));
		Продажа.Дата = ТекущаяДатаСеанса() - 60;
		Итог2 = ТестЗаписать(Продажа);
		Шаг2 = ТестТекстОстатков("VM-SP-003");
		Приход.Товары[0].Количество = 1;
		Итог3 = ТестЗаписать(Приход);
		Шаг3 = ТестТекстОстатков("VM-SP-003");
		Итог4 = ТестЗаписать(Приход.Ссылка.ПолучитьОбъект(), РежимЗаписиДокумента.ОтменаПроведения);
		ТестЗапись(Лог, Код, Итог = "ПРОВЕДЁН" И Итог2 = "ПРОВЕДЁН" И СтрНачинаетсяС(Итог3, "ОТКАЗ") И СтрНачинаетсяС(Итог4, "ОТКАЗ"),
			СтрШаблон("приход 5: %1 (%5); продажа всего свободного: %2 (%6); приход уменьшен до 1: %3 (%7); отмена проведения прихода: %4", Итог, Итог2, Итог3, Итог4, Шаг1, Шаг2, Шаг3));

	ИначеЕсли Код = "Б20" Тогда // один товар нельзя записать в бронь двумя строками
		Д = ТестНовыйДокумент("Бронирование", "Соколов", "VM-SP-003:1;VM-SP-003:1");
		Д.Товары[1].Цена = Д.Товары[0].Цена * 2;
		Итог = ТестЗаписать(Д);
		ТестЗапись(Лог, Код, СтрНачинаетсяС(Итог, "ОТКАЗ") И СтрНайти(Итог, "несколько раз") > 0, Итог);

	ИначеЕсли Код = "Б21" Тогда // по закрытой брони нельзя создать продажу или отмену на основании
		Итоги = Новый Массив;
		Для Каждого Вид Из СтрРазделить("Расход,ОтменаБронирования", ",") Цикл
			Попытка
				Д = Документы[Вид].СоздатьДокумент();
				Д.Заполнить(ОтладкаДокумент("Бронирование", "1"));
				Итоги.Добавить(Вид + ": создан, строк " + Д.Товары.Количество());
			Исключение
				Итоги.Добавить(Вид + ": ОТКАЗ: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЦикла;
		Текст = СтрСоединить(Итоги, "; ");
		ТестЗапись(Лог, Код, СтрЧислоВхождений(Текст, "уже закрыта") = 2, Текст);

	ИначеЕсли Код = "Б22" Тогда // вторая отмена той же брони задним числом не уводит резерв в минус
		Бронь = ТестНовыйДокумент("Бронирование", "Соколов", "VM-SP-003:3");
		Бронь.Дата = ТекущаяДатаСеанса() - 300;
		Итог = ТестЗаписать(Бронь);
		Отмена1 = Документы.ОтменаБронирования.СоздатьДокумент();
		Отмена1.Заполнить(Бронь.Ссылка);
		Отмена1.Дата = ТекущаяДатаСеанса() - 60;
		Итог2 = ТестЗаписать(Отмена1);
		Отмена2 = Документы.ОтменаБронирования.СоздатьДокумент();
		Отмена2.Бронирование = Бронь.Ссылка;
		Отмена2.Дата = ТекущаяДатаСеанса() - 120;
		ЗаполнитьЗначенияСвойств(Отмена2.Товары.Добавить(), Отмена1.Товары[0], "Номенклатура, Количество");
		Итог3 = ТестЗаписать(Отмена2);
		ТестЗапись(Лог, Код, Итог = "ПРОВЕДЁН" И Итог2 = "ПРОВЕДЁН" И СтрНачинаетсяС(Итог3, "ОТКАЗ"),
			СтрШаблон("бронь 3 шт.: %1; отмена: %2; вторая отмена той же брони более ранней датой: %3", Итог, Итог2, Итог3));

	ИначеЕсли Код = "Р15" Тогда // сумма, введённая в приходе вручную, не меняется при записи
		Д = ТестНовыйДокумент("Приход", "ТехноДистрибуция", "VM-SP-003:3");
		Д.Товары[0].Сумма = 100;
		Д.Товары[0].Цена = 33.33;
		Итог = ТестЗаписать(Д);
		ТестЗапись(Лог, Код, Итог = "ПРОВЕДЁН" И Д.Товары[0].Сумма = 100 И Д.СуммаДокумента = 100,
			СтрШаблон("%1; 3 шт. на 100 руб.: цена %2, сумма после записи %3", Итог, Д.Товары[0].Цена, Д.Товары[0].Сумма));

	ИначеЕсли Код = "Р16" Тогда // артикул товара уникален
		Товар = Справочники.Номенклатура.СоздатьЭлемент();
		Товар.Наименование = "Тестовый дубль артикула";
		Товар.Артикул = "VM-SP-001";
		Проверка = Товар.ПроверитьЗаполнение();
		Тексты = Новый Массив;
		Для Каждого С Из ПолучитьСообщенияПользователю(Истина) Цикл
			Тексты.Добавить(С.Текст);
		КонецЦикла;
		ТестЗапись(Лог, Код, Не Проверка И СтрНайти(СтрСоединить(Тексты, " | "), "VM-SP-001") > 0,
			"проверка заполнения: " + ?(Проверка, "Да", "Нет") + "; " + СтрСоединить(Тексты, " | "));

	ИначеЕсли Код = "А07" Тогда // демо-данные не загружаются в базу, где уже есть данные
		ТестЗапись(Лог, Код, Не ДемоДанные.НужноЗаполнить(), "НужноЗаполнить() в заполненной базе: " + ?(ДемоДанные.НужноЗаполнить(), "Да", "Нет"));

	ИначеЕсли Код = "А01" Тогда // регламентное задание снимает просроченные брони
		До = РаботаСБронями.АктивныеБрони();
		Просрочено = До.НайтиСтроки(Новый Структура("Просрочена", Истина));
		Бронь = ОтладкаДокумент("Бронирование", "4");
		СвободноДо = ТестОстатки("VM-TV-002").Свободно;
		Р = РаботаСБронями.СнятьПросроченныеБрони();
		С = РаботаСБронями.СостояниеБрони(Бронь);
		Отмена = Неопределено;
		Для Каждого Ссылка Из Р.Документы Цикл
			Если Ссылка.Бронирование = Бронь Тогда
				Отмена = Ссылка;
			КонецЕсли;
		КонецЦикла;
		ПослеПросрочено = РаботаСБронями.АктивныеБрони().НайтиСтроки(Новый Структура("Просрочена", Истина)).Количество();
		ТестЗапись(Лог, Код, Просрочено.Количество() > 0 И Р.Снято = Просрочено.Количество() И Р.Ошибки.Количество() = 0 И С.Код = 4
			И ПослеПросрочено = 0 И Отмена <> Неопределено И Отмена.Автоматически И Отмена.Причина = РаботаСБронями.ПричинаИстекСрок()
			И ТестОстатки("VM-TV-002").Свободно = СвободноДо + 1,
			СтрШаблон("просрочено до запуска: %1; снято: %2; ошибок: %3; бронь № 4: %4; отмена: %5, причина «%6», авто %7; VM-TV-002 свободно %8→%9; просрочено после: %10",
				Просрочено.Количество(), Р.Снято, Р.Ошибки.Количество(), С.Представление, Отмена, ?(Отмена = Неопределено, "", Отмена.Причина),
				?(Отмена = Неопределено, "", Отмена.Автоматически), СвободноДо, ТестОстатки("VM-TV-002").Свободно, ПослеПросрочено));

	ИначеЕсли Код = "А02" Тогда // бронь, срок которой не истёк, не снимается
		Д = ТестНовыйДокумент("Бронирование", "Кузнецова", "VM-SP-003:1");
		Д.СрокБрони = НачалоДня(ТекущаяДатаСеанса()); // действует до конца сегодняшнего дня
		Итог = ТестЗаписать(Д);
		Р = РаботаСБронями.СнятьПросроченныеБрони();
		С = РаботаСБронями.СостояниеБрони(Д.Ссылка);
		Снята = Ложь;
		Для Каждого Ссылка Из Р.Документы Цикл
			Снята = Снята Или Ссылка.Бронирование = Д.Ссылка;
		КонецЦикла;
		ТестЗапись(Лог, Код, Итог = "ПРОВЕДЁН" И Не Снята И С.Код = 1 И С.ВРезерве = 1,
			СтрШаблон("%1; срок до %2; после запуска: %3, в резерве %4 шт.; всего снято заданием: %5",
				Итог, Формат(Д.СрокБрони, "ДЛФ=D"), С.Представление, С.ВРезерве, Р.Снято));

	ИначеЕсли Код = "А03" Тогда // у частично выкупленной брони снимается только остаток
		Д = ТестНовыйДокумент("Бронирование", "Попова", "VM-AU-003:1;VM-AC-003:2");
		Д.Дата = Д.Дата - 120; // бронь раньше продажи, а не в ту же секунду
		Итог = ТестЗаписать(Д);
		Продажа = Документы.Расход.СоздатьДокумент();
		Продажа.Дата = ТекущаяДатаСеанса();
		Продажа.Заполнить(Д.Ссылка);
		Продажа.Товары.Удалить(1); // выкупили только наушники
		Итог2 = ТестЗаписать(Продажа);
		ТестСрокИстек(Д.Ссылка);
		СкладДо = ТестОстатки("VM-AC-003");
		Р = РаботаСБронями.СнятьПросроченныеБрони();
		С = РаботаСБронями.СостояниеБрони(Д.Ссылка);
		СкладПосле = ТестОстатки("VM-AC-003");
		Снято = 0;
		Для Каждого Ссылка Из Р.Документы Цикл
			Если Ссылка.Бронирование = Д.Ссылка Тогда
				Снято = Ссылка.Товары.Итог("Количество");
			КонецЕсли;
		КонецЦикла;
		ТестЗапись(Лог, Код, Итог = "ПРОВЕДЁН" И Итог2 = "ПРОВЕДЁН" И Снято = 2 И С.Код = 5 И С.Выкуплено = 1 И С.ВРезерве = 0
			И СкладПосле.НаСкладе = СкладДо.НаСкладе И СкладПосле.Свободно = СкладДо.Свободно + 2,
			СтрШаблон("бронь %1, продажа %2; снято заданием %3 шт.; состояние: %4 (выкуплено %5, отменено %6, в резерве %7); ",
				Итог, Итог2, Снято, С.Представление, С.Выкуплено, С.Отменено, С.ВРезерве)
			+ СтрШаблон("VM-AC-003 склад %1→%2, свободно %3→%4", СкладДо.НаСкладе, СкладПосле.НаСкладе, СкладДо.Свободно, СкладПосле.Свободно));

	ИначеЕсли Код = "А04" Тогда // повторный запуск ничего не дублирует
		Р1 = РаботаСБронями.СнятьПросроченныеБрони();
		Отмен = ТестКоличествоОтмен();
		Р2 = РаботаСБронями.СнятьПросроченныеБрони();
		ТестЗапись(Лог, Код, Р1.Снято > 0 И Р2.Снято = 0 И Р2.Ошибки.Количество() = 0 И ТестКоличествоОтмен() = Отмен,
			СтрШаблон("первый запуск: снято %1; второй запуск: снято %2, ошибок %3; документов «Отмена брони» после первого %4, после второго %5",
				Р1.Снято, Р2.Снято, Р2.Ошибки.Количество(), Отмен, ТестКоличествоОтмен()));

	ИначеЕсли Код = "А05" Тогда // отчёт «Остаток, забронировано, доступно» совпадает с регистрами накопления
		Схема = Отчеты.ДоступностьТоваров.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
		Т = ТестТаблица(Схема.НаборыДанных[0].Запрос);
		Склад = ТестТаблица("ВЫБРАТЬ ЕСТЬNULL(СУММА(О.КоличествоОстаток), 0) КАК К ИЗ РегистрНакопления.ОстаткиТоваров.Остатки КАК О")[0].К;
		Резерв = ТестТаблица("ВЫБРАТЬ ЕСТЬNULL(СУММА(Р.КоличествоОстаток), 0) КАК К ИЗ РегистрНакопления.ТоварыВРезерве.Остатки КАК Р")[0].К;
		Ошибок = 0;
		Для Каждого Строка Из Т Цикл
			О = РаботаСЦенами.ОстаткиТовара(Строка.Номенклатура);
			Если Строка.Остаток <> О.НаСкладе Или Строка.Забронировано <> О.ВРезерве Или Строка.Доступно <> О.Свободно Тогда
				Ошибок = Ошибок + 1;
			КонецЕсли;
		КонецЦикла;
		Стр = Т.Найти(ТестТовар("VM-NB-002"), "Номенклатура");
		ТестЗапись(Лог, Код, Ошибок = 0 И Т.Итог("Остаток") = Склад И Т.Итог("Забронировано") = Резерв И Т.Итог("Доступно") = Склад - Резерв
			И Т.Количество() = Т.Скопировать(, "Номенклатура").Количество(),
			СтрШаблон("строк отчёта: %1, расхождений с регистрами: %2; итог: остаток %3 (РН ОстаткиТоваров %4), забронировано %5 (РН ТоварыВРезерве %6), доступно %7; ",
				Т.Количество(), Ошибок, Т.Итог("Остаток"), Склад, Т.Итог("Забронировано"), Резерв, Т.Итог("Доступно"))
			+ СтрШаблон("VM-NB-002: остаток %1, забронировано %2, доступно %3", Стр.Остаток, Стр.Забронировано, Стр.Доступно));

	ИначеЕсли Код = "А06" Тогда // регламентное задание есть в базе, расписание — каждый час
		УстановитьПривилегированныйРежим(Истина);
		З = РегламентныеЗадания.НайтиПредопределенное(Метаданные.РегламентныеЗадания.СнятиеПросроченныхБроней);
		Метод = Метаданные.РегламентныеЗадания.СнятиеПросроченныхБроней.ИмяМетода;
		ТестЗапись(Лог, Код, З <> Неопределено И Метаданные.РегламентныеЗадания.СнятиеПросроченныхБроней.Использование
			И З.Расписание.ПериодПовтораВТечениеДня = 3600 И Метод = "РаботаСБронями.СнятиеПросроченныхБронейПоРасписанию",
			СтрШаблон("задание «%1»; метод %2; расписание: %3", З.Наименование, Метод, З.Расписание));

	КонецЕсли;

КонецПроцедуры

// Продлевает срок брони на неделю, не перепроводя её; возвращает прежний срок
Функция ТестПродлить(Бронь)
	Объект = Бронь.ПолучитьОбъект();
	Было = Объект.СрокБрони;
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.СрокБрони = НачалоДня(ТекущаяДатаСеанса()) + 7 * 86400;
	Объект.Записать();
	Возврат Было;
КонецФункции

Процедура ТестВернутьСрок(Бронь, Срок)
	Объект = Бронь.ПолучитьОбъект();
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.СрокБрони = Срок;
	Объект.Записать();
КонецПроцедуры

// Делает срок брони истёкшим (вчера), не перепроводя её
Процедура ТестСрокИстек(Бронь)
	Объект = Бронь.ПолучитьОбъект();
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.СрокБрони = НачалоДня(ТекущаяДатаСеанса()) - 86400;
	Объект.Записать();
КонецПроцедуры

Функция ТестКоличествоОтмен()
	Возврат ТестТаблица("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ Документ.ОтменаБронирования КАК Д")[0].К;
КонецФункции

Функция ТестТаблица(ТекстЗапроса)
	Запрос = Новый Запрос(ТекстЗапроса);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции
